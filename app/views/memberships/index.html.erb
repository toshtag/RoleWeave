<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title", organization: @organization.name) %></h1>

<% if current_membership&.owner? %>
  <p>
    <%= link_to t(".invite"),
                new_organization_invitation_path(locale: I18n.locale, organization_id: @organization) %>
  </p>
<% end %>

<% if @errors&.any? %>
  <p class="form-error" role="alert"><%= @errors.full_messages.to_sentence %></p>
<% end %>

<ul>
  <% @memberships.each do |membership| %>
    <li>
      <%= membership.user.email_address %>
      <%= t("memberships.roles.#{membership.role}") %>

      <%#
        役割を変えられるのは管理者だけとする。
        画面から消しても経路は残るため、制限は Controller 側が持つ。
      %>
      <% if current_membership&.owner? && membership.user != current_user %>
        <%= form_with model: membership,
                      url: organization_membership_path(locale: I18n.locale, organization_id: @organization, id: membership),
                      method: :patch do |form| %>
          <%= form.label :role, t(".change_role"), for: "role_#{membership.id}" %>
          <%= form.select :role,
                          Membership::ROLES.map { |role| [ t("memberships.roles.#{role}"), role ] },
                          {},
                          id: "role_#{membership.id}" %>
          <%= form.submit t(".submit"), class: "button" %>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

<% if @membership_events %>
  <h2><%= t(".history") %></h2>

  <%#
    履歴は管理者だけが見られる。誰がいつ役割を変えたかは、組織の運営に属する情報である。
  %>
  <ul>
    <% @membership_events.each do |event| %>
      <li>
        <%= l(event.created_at, format: :long) %>
        <%= event.user&.email_address || t(".removed_account") %>
        <% if event.kind == "joined" %>
          <%= t(".joined", role: t("memberships.roles.#{event.to_role}")) %>
        <% else %>
          <%= t(".role_changed",
                from: t("memberships.roles.#{event.from_role}"),
                to: t("memberships.roles.#{event.to_role}")) %>
        <% end %>
        <%= t(".changed_by", email_address: event.changed_by&.email_address || t(".removed_account")) %>
      </li>
    <% end %>
  </ul>
<% end %>
