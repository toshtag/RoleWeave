<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title") %></h1>

<%#
  未入力の項目は行ごと出さない。空欄を並べると、
  その項目が「無い」のか「書かれていない」のかが読み手に分からない。
%>
<dl>
  <dt><%= CandidateProfile.human_attribute_name(:display_name) %></dt>
  <dd><%= @candidate_profile.display_name %></dd>

  <% { location: @candidate_profile.location,
       desired_occupation: @candidate_profile.desired_occupation }.each do |attribute, value| %>
    <% next if value.blank? %>
    <dt><%= CandidateProfile.human_attribute_name(attribute) %></dt>
    <dd><%= value %></dd>
  <% end %>
</dl>

<% if @candidate_profile.introduction.present? %>
  <h2><%= CandidateProfile.human_attribute_name(:introduction) %></h2>
  <div class="job-posting__body"><%= simple_format(@candidate_profile.introduction) %></div>
<% end %>

<h2><%= t(".desired_condition") %></h2>

<% if @candidate_profile.desired_condition.present? && !@candidate_profile.desired_condition.blank_conditions? %>
  <% desired_condition = @candidate_profile.desired_condition %>
  <dl>
    <% if desired_condition.employment_type.present? %>
      <dt><%= DesiredCondition.human_attribute_name(:employment_type) %></dt>
      <dd><%= t("job_postings.employment_types.#{desired_condition.employment_type}") %></dd>
    <% end %>

    <%# 通貨のない金額は読めないため、必ず対で出す。 %>
    <% if desired_condition.annual_salary_min.present? %>
      <dt><%= DesiredCondition.human_attribute_name(:annual_salary_min) %></dt>
      <dd>
        <%= t("job_postings.salary_currencies.#{desired_condition.salary_currency}") %>
        <%= number_with_delimiter(desired_condition.annual_salary_min) %>
      </dd>
    <% end %>

    <% { location: desired_condition.location, note: desired_condition.note }.each do |attribute, value| %>
      <% next if value.blank? %>
      <dt><%= DesiredCondition.human_attribute_name(attribute) %></dt>
      <dd><%= value %></dd>
    <% end %>

    <% if desired_condition.available_from.present? %>
      <dt><%= DesiredCondition.human_attribute_name(:available_from) %></dt>
      <dd><%= l(desired_condition.available_from, format: :long) %></dd>
    <% end %>
  </dl>
<% else %>
  <p><%= t(".desired_condition_empty") %></p>
<% end %>

<h2><%= t(".completeness") %></h2>

<%#
  そろっていない項目を名前で示す。割合や点数として出すと、
  「上げるために埋める」圧力になり、応募に不要な情報まで書かせることになる。
%>
<% if @completeness.complete? %>
  <p><%= t(".completeness_complete") %></p>
<% else %>
  <p><%= t(".completeness_missing") %></p>
  <ul>
    <% @completeness.missing_items.each do |item| %>
      <li><%= t(".completeness_items.#{item}") %></li>
    <% end %>
  </ul>
<% end %>

<p><%= link_to t(".edit"), edit_profile_path(locale: I18n.locale) %></p>
<p><%= link_to t(".work_experiences"), profile_work_experiences_path(locale: I18n.locale) %></p>
<p><%= link_to t(".educations"), profile_educations_path(locale: I18n.locale) %></p>
<p><%= link_to t(".skills"), profile_skills_path(locale: I18n.locale) %></p>
<p><%= link_to t(".desired_condition_edit"), edit_profile_desired_condition_path(locale: I18n.locale) %></p>
<p><%= link_to t(".documents"), edit_profile_documents_path(locale: I18n.locale) %></p>
<p><%= link_to t(".visibility"), edit_profile_visibility_path(locale: I18n.locale) %></p>
<p><%= link_to t(".applications"), profile_applications_path(locale: I18n.locale) %></p>
<p><%= link_to t(".saved_jobs"), profile_saved_jobs_path(locale: I18n.locale) %></p>
<p><%= link_to t(".saved_searches"), profile_saved_searches_path(locale: I18n.locale) %></p>
<p><%= link_to t(".scouts"), profile_scouts_path(locale: I18n.locale) %></p>
<p><%= link_to t(".export"), export_path(locale: I18n.locale) %></p>

<%# プロフィールだけを消し、アカウントは残す。 %>
<%= button_to t(".destroy"),
              profile_path(locale: I18n.locale),
              method: :delete,
              form: { data: { turbo_confirm: t(".destroy_confirm") } },
              class: "button button--quiet" %>
