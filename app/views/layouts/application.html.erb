<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("application.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# キーボード操作で、ヘッダーを読み飛ばして本文の先頭へ移動できるようにする。 %>
    <%= link_to t("application.skip_to_content"), "#main-content", class: "skip-link" %>

    <header class="site-header">
      <div class="site-header__inner">
        <%# ブランドは表示中のロケールの入口へ戻す。ここで言語が変わると、遷移が予測できない。 %>
        <%= link_to t("application.name"),
                    localized_root_path(locale: I18n.locale),
                    class: "site-header__brand" %>
      </div>
    </header>

    <%# 本文領域はレイアウトが持つ。各画面が main を作ると、入れ子や重複が起こり得る。 %>
    <%#
      tabindex="-1" はスキップリンクの移動先をフォーカス可能にするために置く。
      これがないと、画面はスクロールしてもフォーカスはリンクに残り、
      次の Tab がヘッダーへ戻る。通常の Tab 順序へは入れないため 0 ではなく -1 とする。
    %>
    <main id="main-content" tabindex="-1">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p><%= t("application.footer.description") %></p>
      </div>
    </footer>
  </body>
</html>
