<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("application.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%# 同じ内容へ複数の URL から到達できる画面は、正となる URL を示す。 %>
    <% if content_for?(:canonical) %>
      <link rel="canonical" href="<%= yield :canonical %>">
    <% end %>

    <%# 検索結果へ載せたくない画面は、robots を宣言する。 %>
    <% if content_for?(:robots) %>
      <meta name="robots" content="<%= yield :robots %>">
    <% end %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# キーボード操作で、ヘッダーを読み飛ばして本文の先頭へ移動できるようにする。 %>
    <%= link_to t("application.skip_to_content"), "#main-content", class: "skip-link" %>

    <header class="site-header">
      <div class="site-header__inner">
        <%# ブランドは表示中のロケールの入口へ戻す。ここで言語が変わると、遷移が予測できない。 %>
        <%= link_to t("application.name"),
                    localized_root_path(locale: I18n.locale),
                    class: "site-header__brand" %>

        <%#
          ログイン状態は、画面から読み取れる形で示す。
          示さないと、共有端末で前の利用者のまま操作を続ける事故が起こる。
          ログアウトは DELETE で送る。リンクにすると、先読みだけでログアウトが起こる。
        %>
        <nav class="site-header__account" aria-label="<%= t("application.account.label") %>">
          <% if signed_in? %>
            <%= link_to t("application.account.profile"),
                        profile_path(locale: I18n.locale) %>
            <%= link_to t("application.account.organizations"),
                        organizations_path(locale: I18n.locale) %>
<%#
  未読の件数を出す。通知は開かない限り気付けないため、
  入口を常に見える場所へ置く。
%>
<%= link_to t("application.account.notifications", count: unread_notification_count),
            notifications_path(locale: I18n.locale) %>
            <%= link_to current_user.email_address,
                        account_path(locale: I18n.locale),
                        class: "site-header__account-name" %>
            <%= button_to t("application.account.sign_out"),
                          session_path(locale: I18n.locale),
                          method: :delete,
                          class: "button button--quiet" %>
          <% else %>
            <%= link_to t("application.account.sign_in"),
                        new_session_path(locale: I18n.locale) %>
            <%= link_to t("application.account.sign_up"),
                        new_registration_path(locale: I18n.locale) %>
          <% end %>
        </nav>

        <%#
          表示言語の正本は URL とする。Cookie や Accept-Language で切り替えると、
          閲覧者が見ている URL と表示言語が一致しない状態が生まれる。
          選択肢は I18n.available_locales から導く。ここへ言語を書き並べると、
          対応言語が増えたときに、切替へ現れない言語ができる。
        %>
        <nav class="language-switcher" aria-label="<%= t("application.language_switcher.label") %>">
          <ul class="language-switcher__list">
            <% I18n.available_locales.each do |locale| %>
              <% language_name = t("application.language_switcher.languages.#{locale}") %>
              <li class="language-switcher__item">
                <% if locale == I18n.locale %>
                  <%# 現在地への自己リンクは、たどっても何も起きない導線になる。 %>
                  <span class="language-switcher__current" lang="<%= locale %>" aria-current="page"><%= language_name %></span>
                <% else %>
                  <%= link_to language_name,
                              localized_root_path(locale: locale),
                              class: "language-switcher__link",
                              lang: locale,
                              hreflang: locale %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

    <%# 本文領域はレイアウトが持つ。各画面が main を作ると、入れ子や重複が起こり得る。 %>
    <%#
      tabindex="-1" はスキップリンクの移動先をフォーカス可能にするために置く。
      これがないと、画面はスクロールしてもフォーカスはリンクに残り、
      次の Tab がヘッダーへ戻る。通常の Tab 順序へは入れないため 0 ではなく -1 とする。
    %>
    <main id="main-content" tabindex="-1">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p><%= t("application.footer.description") %></p>
      </div>
    </footer>
  </body>
</html>
