<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title") %></h1>

<%#
  失敗の理由は 1 つの文言へまとめる。項目ごとに理由を分けると、
  ログイン画面がメールアドレスの登録有無を調べる道具になる。
%>
<% if flash.now[:alert] || flash[:alert] %>
  <p class="form-error" role="alert"><%= flash[:alert] %></p>
<% end %>

<%= form_with url: session_path(locale: I18n.locale), method: :post, class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :email_address, User.human_attribute_name(:email_address) %>
    <%#
      autocomplete は入力の手間を減らすためだけのものではない。
      パスワード管理ソフトが、どの欄へ何を入れるかを判断する手がかりになる。
    %>
    <%= form.email_field :email_address,
                         value: @email_address,
                         required: true,
                         autocomplete: "username",
                         autofocus: true %>
  </div>

  <div class="form__field">
    <%= form.label :password, User.human_attribute_name(:password) %>
    <%# 入力されたパスワードは画面へ書き戻さない。 %>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
  </div>

  <%= form.submit t(".submit"), class: "button" %>
<% end %>

<p><%= link_to t(".sign_up"), new_registration_path(locale: I18n.locale) %></p>
