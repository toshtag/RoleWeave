<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title", organization: @organization.name) %></h1>

<% if flash[:alert] %>
  <p class="form-error" role="alert"><%= flash[:alert] %></p>
<% end %>

<p>
  <%= link_to t(".new"),
              new_organization_job_posting_path(locale: I18n.locale, organization_id: @organization) %>
</p>

<% if @job_postings.any? %>
  <ul>
    <% @job_postings.each do |job_posting| %>
      <li>
        <%= job_posting.title %>
        <%= t("job_postings.statuses.#{job_posting.status}") %>

        <%= link_to t(".preview"),
                    preview_organization_job_posting_path(locale: I18n.locale, organization_id: @organization, id: job_posting) %>

        <%# 状態に応じて、いま行える操作だけを出す。 %>
        <% if job_posting.editable? %>
          <%= link_to t(".edit"),
                      edit_organization_job_posting_path(locale: I18n.locale, organization_id: @organization, id: job_posting) %>
        <% end %>

        <% if job_posting.can_transition_to?("pending_review") %>
          <%= button_to t(".submit"),
                        organization_job_posting_submit_path(locale: I18n.locale, organization_id: @organization, job_posting_id: job_posting),
                        method: :patch,
                        class: "button button--quiet" %>
        <% end %>

        <%#
          承認と差し戻しは管理者だけができる。
          画面から消しても経路は残るため、制限は Controller 側が持つ。
        %>
        <% if current_membership&.owner? && job_posting.can_transition_to?("published") %>
          <%= button_to t(".approve"),
                        organization_job_posting_approve_path(locale: I18n.locale, organization_id: @organization, job_posting_id: job_posting),
                        method: :patch,
                        class: "button button--quiet" %>
          <%= button_to t(".reject"),
                        organization_job_posting_reject_path(locale: I18n.locale, organization_id: @organization, job_posting_id: job_posting),
                        method: :patch,
                        class: "button button--quiet" %>
        <% end %>

        <%# 停止も公開と同じ重さの操作とし、管理者だけへ出す。 %>
        <% if current_membership&.owner? && job_posting.can_transition_to?("suspended") %>
          <%= button_to t(".suspend"),
                        organization_job_posting_suspend_path(locale: I18n.locale, organization_id: @organization, job_posting_id: job_posting),
                        method: :patch,
                        class: "button button--quiet" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".empty") %></p>
<% end %>

<% if @job_posting_events.any? %>
  <h2><%= t(".history") %></h2>

  <%#
    履歴は所属者であれば見られる。差し戻された担当者が、
    いつ差し戻されたかを自分で確認できる必要がある。
  %>
  <ul>
    <% @job_posting_events.each do |event| %>
      <li>
        <%= l(event.created_at, format: :long) %>
        <%= event.job_posting_title %>
        <% if event.created? %>
          <%= t(".created") %>
        <% else %>
          <%= t(".status_changed",
                from: t("job_postings.statuses.#{event.from_status}"),
                to: t("job_postings.statuses.#{event.to_status}")) %>
        <% end %>
        <%= t(".changed_by", email_address: event.changed_by&.email_address || t(".removed_account")) %>
      </li>
    <% end %>
  </ul>
<% end %>
