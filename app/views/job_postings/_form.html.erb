<%= form_with model: job_posting, url: url, class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :title %>
    <%= form.text_field :title,
                        required: true,
                        autofocus: true,
                        aria: { describedby: field_error_id(job_posting, :title) } %>
    <%= render "registrations/field_errors", record: job_posting, attribute: :title %>
  </div>

  <div class="form__field">
    <%= form.label :description %>
    <%= form.text_area :description,
                       required: true,
                       rows: 8,
                       aria: { describedby: field_error_id(job_posting, :description) } %>
    <%= render "registrations/field_errors", record: job_posting, attribute: :description %>
  </div>

  <div class="form__field">
    <%= form.label :location %>
    <%= form.text_field :location %>
  </div>

  <div class="form__field">
    <%= form.label :occupation %>
    <%= form.text_field :occupation %>
  </div>

  <div class="form__field">
    <%= form.label :employment_type %>
    <%#
      選択肢は JobPosting::EMPLOYMENT_TYPES から導く。ここへ値を書き並べると、
      種類が増えたときに画面へ現れない種類ができる。
    %>
    <%= form.select :employment_type,
                    JobPosting::EMPLOYMENT_TYPES.map { |type| [ t("job_postings.employment_types.#{type}"), type ] },
                    include_blank: t(".unspecified"),
                    aria: { describedby: field_error_id(job_posting, :employment_type) } %>
    <%= render "registrations/field_errors", record: job_posting, attribute: :employment_type %>
  </div>

  <div class="form__field">
    <%= form.label :salary %>
    <%= form.text_field :salary %>
  </div>

  <%#
    金額での絞り込みに使う値。自由記述の給与とは別に持つ。
    「経験に応じて相談」のように金額で表せない求人は、ここを空のままにする。
  %>
  <div class="form__field">
    <%= form.label :salary_currency %>
    <%= form.select :salary_currency,
                    JobPosting::SALARY_CURRENCIES.map { |currency| [ t("job_postings.salary_currencies.#{currency}"), currency ] },
                    { include_blank: t(".unspecified") },
                    aria: { describedby: field_error_id(job_posting, :salary_currency) } %>
    <%= render "registrations/field_errors", record: job_posting, attribute: :salary_currency %>
  </div>

  <div class="form__field">
    <%= form.label :annual_salary_min %>
    <%= form.number_field :annual_salary_min,
                          min: 0,
                          aria: { describedby: field_error_id(job_posting, :annual_salary_min) } %>
    <%= render "registrations/field_errors", record: job_posting, attribute: :annual_salary_min %>
  </div>

  <div class="form__field">
    <%= form.label :annual_salary_max %>
    <%= form.number_field :annual_salary_max,
                          min: 0,
                          aria: { describedby: field_error_id(job_posting, :annual_salary_max) } %>
    <%= render "registrations/field_errors", record: job_posting, attribute: :annual_salary_max %>
  </div>

  <div class="form__field">
    <%= form.label :requirements %>
    <%= form.text_area :requirements, rows: 5 %>
  </div>

  <%= form.submit submit_label, class: "button" %>
<% end %>
