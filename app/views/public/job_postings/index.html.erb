<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>
<%#
  条件を持つ一覧の canonical は、条件を持たない一覧とする。
  同じ求人の集合へ無数の URL から到達できる状態を、検索エンジンへ渡さない。
%>
<% filtered = @search.any? { |_key, value| value.present? } %>
<%
  # 条件を持たない一覧の canonical は、そのページ自身とする。
  # 2 ページ目以降を 1 ページ目の複製として扱うと、そこにしかない求人が索引されない。
  canonical_options = { locale: I18n.locale }
  canonical_options[:page] = @pagination.current_page if !filtered && @pagination.current_page > 1
%>
<% content_for :canonical, public_job_postings_url(canonical_options) %>
<% if filtered %>
  <%# 条件つきの結果は索引させない。リンクはたどらせる。 %>
  <% content_for :robots, "noindex, follow" %>
<% end %>

<h1><%= t(".title") %></h1>

<%= form_with url: public_job_postings_path(locale: I18n.locale), method: :get, class: "form search-form" do |form| %>
  <div class="form__field">
    <%= form.label :keyword, t(".keyword") %>
    <%= form.search_field :keyword, value: @search[:keyword] %>
  </div>

  <div class="form__field">
    <%= form.label :location, JobPosting.human_attribute_name(:location) %>
    <%= form.text_field :location, value: @search[:location] %>
  </div>

  <div class="form__field">
    <%= form.label :occupation, JobPosting.human_attribute_name(:occupation) %>
    <%= form.text_field :occupation, value: @search[:occupation] %>
  </div>

  <div class="form__field">
    <%= form.label :employment_type, JobPosting.human_attribute_name(:employment_type) %>
    <%= form.select :employment_type,
                    JobPosting::EMPLOYMENT_TYPES.map { |type| [ t("job_postings.employment_types.#{type}"), type ] },
                    { include_blank: t(".any_employment_type"), selected: @search[:employment_type] } %>
  </div>

  <%#
    給与は「通貨」と「最低年収」の組で絞り込む。
    通貨をまたいだ比較は、為替の時点を決めないと成り立たない。
  %>
  <div class="form__field">
    <%= form.label :salary_currency, JobPosting.human_attribute_name(:salary_currency) %>
    <%= form.select :salary_currency,
                    JobPosting::SALARY_CURRENCIES.map { |currency| [ t("job_postings.salary_currencies.#{currency}"), currency ] },
                    { include_blank: t(".any_currency"), selected: @search[:salary_currency] } %>
  </div>

  <div class="form__field">
    <%= form.label :minimum_salary, t(".minimum_salary") %>
    <%= form.number_field :minimum_salary, min: 0, value: @search[:minimum_salary] %>
  </div>

  <%= form.submit t(".submit"), class: "button" %>
<% end %>

<%#
  いまの条件を保存する。検索の条件をそのまま渡す。
  ログインしていない場合はログインへ送られる。
%>
<%= form_with url: profile_saved_searches_path(locale: I18n.locale), method: :post, class: "form" do |form| %>
  <% @search.each do |key, value| %>
    <%= form.hidden_field key, value: value %>
  <% end %>
  <%= form.label :name, t(".save_search_name") %>
  <%= form.text_field :name %>
  <%= form.submit t(".save_search"), class: "button button--quiet" %>
<% end %>

<% if @job_postings.any? %>
  <ul class="job-posting-list">
    <% @job_postings.each do |job_posting| %>
      <li>
        <%= link_to job_posting.title,
                    public_job_posting_path(locale: I18n.locale, id: job_posting) %>
        <p class="job-posting__organization"><%= job_posting.organization&.name %></p>
        <% if job_posting.location.present? %>
          <p><%= job_posting.location %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= filtered ? t(".no_results") : t(".empty") %></p>
<% end %>

<%= render "shared/pagination",
           pagination: @pagination,
           permitted: Public::JobPostingsController::PERMITTED_KEYS %>
