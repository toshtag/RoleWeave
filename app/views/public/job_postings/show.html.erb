<% content_for :title, "#{@job_posting.title} | #{t("application.name")}" %>
<%#
  canonical はこの画面自身の URL とする。
  同じ内容へ複数の URL から到達できる場合に、正となる 1 つを示す。
%>
<% content_for :canonical, public_job_posting_url(locale: I18n.locale, id: @job_posting) %>

<%#
  構造化データ。求人が「求人」として認識されるために要る。
  題名と本文の区別、勤務地、雇用形態、給与は、HTML の見た目からは判定されない。
%>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw job_posting_structured_data(@job_posting).to_json %></script>
<% end %>

<%= render "job_postings/public", job_posting: @job_posting %>

<%#
  応募の導線。ログインしていない場合も出す。
  出さないと、応募できることが分からないまま画面を離れる。
  ログインが要るかどうかは、押した先で伝える。
%>
<p>
  <%= link_to t(".apply"), new_public_job_posting_application_path(locale: I18n.locale, public_job_posting_id: @job_posting) %>
</p>
<%# 気になる求人を保存する。ログインしていない場合はログインへ送られる。 %>
<p>
  <%= button_to t(".save"),
                profile_saved_jobs_path(locale: I18n.locale, job_posting_id: @job_posting),
                method: :post,
                class: "button button--quiet" %>
</p>


<p><%= link_to t(".back"), public_job_postings_path(locale: I18n.locale) %></p>
