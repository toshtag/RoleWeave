<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title", organization: @organization.name) %></h1>

<%= form_with model: @invitation, url: organization_invitations_path(locale: I18n.locale, organization_id: @organization), class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :email_address %>
    <%= form.email_field :email_address,
                         required: true,
                         autofocus: true,
                         aria: { describedby: field_error_id(@invitation, :email_address) } %>
    <%= render "registrations/field_errors", record: @invitation, attribute: :email_address %>
  </div>

  <div class="form__field">
    <%= form.label :role %>
    <%#
      役割の選択肢は Membership::ROLES から導く。ここへ値を書き並べると、
      役割が増えたときに画面へ現れない役割ができる。
    %>
    <%= form.select :role,
                    Membership::ROLES.map { |role| [ t("memberships.roles.#{role}"), role ] },
                    {},
                    required: true,
                    aria: { describedby: field_error_id(@invitation, :role) } %>
    <%= render "registrations/field_errors", record: @invitation, attribute: :role %>
  </div>

  <%= form.submit t(".submit"), class: "button" %>
<% end %>
