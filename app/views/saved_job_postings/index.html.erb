<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title") %></h1>

<% if @saved_job_postings.any? %>
  <ul>
    <% @saved_job_postings.each do |saved| %>
      <li>
        <%#
          保存した求人が公開中でなくなることがある。
          そのまま出すと、開いた先が 404 になる。状態を添える。
        %>
        <% if saved.job_posting.status == "published" %>
          <%= link_to saved.job_posting.title,
                      public_job_posting_path(locale: I18n.locale, id: saved.job_posting) %>
        <% else %>
          <%= saved.job_posting.title %>
          <%= t(".no_longer_published") %>
        <% end %>
        <%= saved.job_posting.organization.name %>
        <%= button_to t(".destroy"),
                      profile_saved_job_path(locale: I18n.locale, id: saved),
                      method: :delete,
                      class: "button button--quiet" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".empty") %></p>
<% end %>

<p><%= link_to t(".back"), profile_path(locale: I18n.locale) %></p>
