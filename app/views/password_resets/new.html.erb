<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title") %></h1>

<p><%= t(".body") %></p>

<%= form_with url: password_reset_path(locale: I18n.locale), method: :post, class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :email_address, User.human_attribute_name(:email_address) %>
    <%= form.email_field :email_address, required: true, autocomplete: "username", autofocus: true %>
  </div>

  <%= form.submit t(".submit"), class: "button" %>
<% end %>
