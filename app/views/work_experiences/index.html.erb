<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title") %></h1>

<p><%= link_to t(".new"), new_profile_work_experience_path(locale: I18n.locale) %></p>

<% if @work_experiences.any? %>
  <ul>
    <% @work_experiences.each do |work_experience| %>
      <li>
        <%= work_experience.organization_name %>
        <%= work_experience.position %>

        <%#
          在籍中は終了日を持たない。空欄のままにすると、
          「まだ在籍している」のか「書き忘れ」なのかが読み手に分からない。
        %>
        <% if work_experience.current? %>
          <%= t(".period_current", started_on: l(work_experience.started_on, format: :long)) %>
        <% else %>
          <%= t(".period",
                started_on: l(work_experience.started_on, format: :long),
                ended_on: l(work_experience.ended_on, format: :long)) %>
        <% end %>

        <% if work_experience.description.present? %>
          <div class="job-posting__body"><%= simple_format(work_experience.description) %></div>
        <% end %>

        <%= link_to t(".edit"),
                    edit_profile_work_experience_path(locale: I18n.locale, id: work_experience) %>
        <%= button_to t(".destroy"),
                      profile_work_experience_path(locale: I18n.locale, id: work_experience),
                      method: :delete,
                      class: "button button--quiet" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".empty") %></p>
<% end %>

<p><%= link_to t(".back"), profile_path(locale: I18n.locale) %></p>
