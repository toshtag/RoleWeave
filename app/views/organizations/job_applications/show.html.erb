<% snapshot = @job_application.candidate_profile_snapshot %>

<% content_for :title, "#{snapshot["display_name"]} | #{t("application.name")}" %>

<%# 応募者の情報は検索へ出さない。 %>
<% content_for :robots, "noindex, nofollow" %>

<h1><%= snapshot["display_name"] %></h1>

<dl>
  <dt><%= t(".applied_at") %></dt>
  <dd><%= l(@job_application.created_at, format: :long) %></dd>

  <dt><%= t(".status") %></dt>
  <dd><%= t("candidate_job_applications.index.statuses.#{@job_application.status}") %></dd>

  <dt><%= t(".stage") %></dt>
  <dd><%= t("job_applications.stages.#{@job_application.stage}") %></dd>
</dl>

<% if flash[:alert] %>
  <p class="form-error" role="alert"><%= flash[:alert] %></p>
<% end %>

<%#
  いま行える操作だけを出す。
  確定（内定・採用・不採用・辞退）は管理者だけへ出す。
  画面から消しても経路は残るため、制限は Controller 側が持つ。
%>
<% JobApplication::STAGE_TRANSITIONS.fetch(@job_application.stage, []).each do |next_stage| %>
  <% next unless @job_application.can_move_to?(next_stage) %>
  <% next if JobApplication.owner_only_stage?(next_stage) && !current_membership&.owner? %>
  <%= button_to t("job_applications.stage_actions.#{next_stage}"),
                organization_job_posting_application_stage_path(
                  locale: I18n.locale, organization_id: @organization,
                  job_posting_id: @job_posting, application_id: @job_application,
                  stage: next_stage
                ),
                method: :patch,
                class: "button button--quiet" %>
<% end %>

<%# 取り消された応募であることを隠さない。選考を進める判断に関わる。 %>
<% if @job_application.withdrawn? %>
  <p class="form-error" role="status"><%= t(".withdrawn_notice") %></p>
<% end %>

<h2><%= t(".snapshot") %></h2>

<p><%= t(".snapshot_notice") %></p>

<% if snapshot["introduction"].present? %>
  <div class="job-posting__body"><%= simple_format(snapshot["introduction"]) %></div>
<% end %>

<% if snapshot["work_experiences"].any? %>
  <h3><%= t("work_experiences.index.title") %></h3>
  <ul>
    <% snapshot["work_experiences"].each do |work_experience| %>
      <li>
        <%= work_experience["organization_name"] %>
        <%= work_experience["position"] %>
        <%= work_experience["started_on"] %>
        <%= work_experience["ended_on"] %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if snapshot["educations"].any? %>
  <h3><%= t("educations.index.title") %></h3>
  <ul>
    <% snapshot["educations"].each do |education| %>
      <li><%= education["school_name"] %> <%= education["field_of_study"] %> <%= education["degree"] %></li>
    <% end %>
  </ul>
<% end %>

<% if snapshot["skills"].any? %>
  <h3><%= t("skills.index.title") %></h3>
  <ul>
    <% snapshot["skills"].each do |skill| %>
      <li><%= skill["name"] %> <%= skill["years_of_experience"] %></li>
    <% end %>
  </ul>
<% end %>

<%#
  いまのプロフィールは、公開範囲が許すときだけ辿れる。
  応募時点の写しは常に見えるが、それは「応募のときに渡されたもの」である。
%>
<% if @candidate_profile.present? %>
  <p>
    <%= link_to t(".current_profile"),
                organization_candidate_profile_path(locale: I18n.locale,
                                                    organization_id: @organization,
                                                    id: @candidate_profile) %>
  </p>
<% end %>

<%#
  面接の予定と結論の期限。どちらも社内の情報であり、応募者へは伝わらない。
%>
<h2><%= t(".interviews") %></h2>

<%= form_with url: organization_job_posting_application_deadline_path(
                locale: I18n.locale, organization_id: @organization,
                job_posting_id: @job_posting, application_id: @job_application
              ),
              method: :patch,
              class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :decide_by, t(".decide_by") %>
    <%= form.date_field :decide_by, value: @job_application.decide_by %>
    <% if @job_application.overdue? %>
      <p class="form-error" role="status"><%= t(".overdue") %></p>
    <% end %>
    <%= form.submit t(".save_deadline"), class: "button button--quiet" %>
  </div>
<% end %>

<% if @interview_schedules.any? %>
  <ul>
    <% @interview_schedules.each do |schedule| %>
      <li>
        <%= l(schedule.starts_at, format: :long) %>
        <%= schedule.location %>
        <% if schedule.duration_minutes.present? %>
          <%= t(".duration", count: schedule.duration_minutes) %>
        <% end %>
        <% if schedule.scheduled? %>
          <%= button_to t(".cancel_interview"),
                        organization_job_posting_application_interview_path(
                          locale: I18n.locale, organization_id: @organization,
                          job_posting_id: @job_posting, application_id: @job_application,
                          id: schedule
                        ),
                        method: :delete,
                        class: "button button--quiet" %>
        <% else %>
          <%= t(".cancelled") %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".no_interviews") %></p>
<% end %>

<%= form_with model: @interview_schedule,
              url: organization_job_posting_application_interviews_path(
                locale: I18n.locale, organization_id: @organization,
                job_posting_id: @job_posting, application_id: @job_application
              ),
              class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :starts_at, InterviewSchedule.human_attribute_name(:starts_at) %>
    <%= form.datetime_field :starts_at, required: true %>
  </div>

  <div class="form__field">
    <%= form.label :duration_minutes, InterviewSchedule.human_attribute_name(:duration_minutes) %>
    <%= form.number_field :duration_minutes, min: 1, max: InterviewSchedule::MAX_DURATION_MINUTES %>
  </div>

  <div class="form__field">
    <%= form.label :location, InterviewSchedule.human_attribute_name(:location) %>
    <%= form.text_field :location %>
  </div>

  <div class="form__field">
    <%= form.label :note, InterviewSchedule.human_attribute_name(:note) %>
    <%= form.text_area :note, rows: 3 %>
  </div>

  <%= form.submit t(".add_interview"), class: "button" %>
<% end %>

<%#
  評価とコメントは応募者には見えない。社内の判断の材料である。
  求職者側の画面・エクスポート・応募の写しには現れない。
%>
<h2><%= t(".reviews") %></h2>

<div class="form__field">
  <%= form_with url: organization_job_posting_application_assignment_path(
                  locale: I18n.locale, organization_id: @organization,
                  job_posting_id: @job_posting, application_id: @job_application
                ),
                method: :patch,
                class: "form" do |form| %>
    <%= form.label :assignee_id, t(".assignee") %>
    <%= form.select :assignee_id,
                    @members.map { |member| [ member.email_address, member.id ] },
                    { include_blank: t(".no_assignee"), selected: @job_application.assignee_id } %>
    <%= form.submit t(".assign"), class: "button button--quiet" %>
  <% end %>
</div>

<% if @application_reviews.any? %>
  <ul>
    <% @application_reviews.each do |review| %>
      <li>
        <%= l(review.created_at, format: :long) %>
        <%= review.reviewer&.email_address || t(".removed_account") %>
        <% if review.rating.present? %>
          <%= t(".rating_value", rating: review.rating, max: ApplicationReview::MAX_RATING) %>
        <% end %>
        <% if review.comment.present? %>
          <div class="job-posting__body"><%= simple_format(review.comment) %></div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".no_reviews") %></p>
<% end %>

<%= form_with model: @application_review,
              url: organization_job_posting_application_reviews_path(
                locale: I18n.locale, organization_id: @organization,
                job_posting_id: @job_posting, application_id: @job_application
              ),
              class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :rating, ApplicationReview.human_attribute_name(:rating) %>
    <%= form.select :rating,
                    (ApplicationReview::MIN_RATING..ApplicationReview::MAX_RATING).to_a,
                    include_blank: t(".no_rating") %>
  </div>

  <div class="form__field">
    <%= form.label :comment, ApplicationReview.human_attribute_name(:comment) %>
    <%= form.text_area :comment, rows: 4 %>
  </div>

  <%= form.submit t(".submit_review"), class: "button" %>
<% end %>

<p>
  <%= link_to t(".back"),
              organization_job_posting_applications_path(
                locale: I18n.locale, organization_id: @organization, job_posting_id: @job_posting
              ) %>
</p>
