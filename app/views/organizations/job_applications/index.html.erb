<% content_for :title, "#{t(".title", title: @job_posting.title)} | #{t("application.name")}" %>

<%# 応募者の情報は検索へ出さない。 %>
<% content_for :robots, "noindex, nofollow" %>

<h1><%= t(".title", title: @job_posting.title) %></h1>

<% if @job_applications.any? %>
  <ul>
    <% @job_applications.each do |job_application| %>
      <li>
        <%#
          名前は応募時点の写しから出す。
          応募の後に表示名が変わっても、応募時に見た名前で追える。
        %>
        <%= link_to job_application.candidate_profile_snapshot["display_name"],
                    organization_job_posting_application_path(
                      locale: I18n.locale, organization_id: @organization,
                      job_posting_id: @job_posting, id: job_application
                    ) %>
        <%= l(job_application.created_at, format: :long) %>
        <%= t("candidate_job_applications.index.statuses.#{job_application.status}") %>
        <%= t("job_applications.stages.#{job_application.stage}") %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".empty") %></p>
<% end %>

<%#
  応募と取消の記録。応募そのものが消えても、何があったかを追える。
%>
<% if @job_application_events.any? %>
  <h2><%= t(".history") %></h2>
  <ul>
    <% @job_application_events.each do |event| %>
      <li>
        <%= l(event.created_at, format: :long) %>
        <%= event.candidate_display_name %>
        <%= event.job_posting_title %>
<% if event.stage_changed? %>
  <%= t(".stage_changed",
        from: t("job_applications.stages.#{event.from_stage}"),
        to: t("job_applications.stages.#{event.to_stage}")) %>
  <%= t(".changed_by", email_address: event.changed_by&.email_address || t(".removed_account")) %>
<% else %>
  <%= t(".kinds.#{event.kind}") %>
<% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<p>
  <%= link_to t(".back"),
              organization_job_postings_path(locale: I18n.locale, organization_id: @organization) %>
</p>
