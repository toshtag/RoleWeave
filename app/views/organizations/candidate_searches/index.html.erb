<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<%# 候補者の情報は検索へ出さない。 %>
<% content_for :robots, "noindex, nofollow" %>

<h1><%= t(".title") %></h1>

<%#
  出るのは、受信を許可した候補者だけである。
  許可していない候補者は、この画面に存在しない。
%>
<p><%= t(".body") %></p>

<%= form_with url: organization_candidate_searches_path(locale: I18n.locale, organization_id: @organization),
              method: :get, class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :skill, t(".skill") %>
    <%= form.text_field :skill, value: @search[:skill] %>
  </div>

  <div class="form__field">
    <%= form.label :location, CandidateProfile.human_attribute_name(:location) %>
    <%= form.text_field :location, value: @search[:location] %>
  </div>

  <div class="form__field">
    <%= form.label :desired_occupation, CandidateProfile.human_attribute_name(:desired_occupation) %>
    <%= form.text_field :desired_occupation, value: @search[:desired_occupation] %>
  </div>

  <%= form.submit t(".submit"), class: "button" %>
<% end %>

<% if @candidate_profiles.any? %>
  <ul>
    <% @candidate_profiles.each do |candidate_profile| %>
      <li>
        <%#
          出すのは限られた項目だけとする。
          経歴の中身は、公開範囲が許すときに詳細で見る。
        %>
        <%= candidate_profile.display_name %>
        <%= candidate_profile.location %>
        <%= candidate_profile.desired_occupation %>
        <%= candidate_profile.skills.alphabetical.map(&:name).join(" / ") %>

        <%= link_to t(".show"),
                    organization_candidate_profile_path(locale: I18n.locale,
                                                        organization_id: @organization,
                                                        id: candidate_profile) %>

<%# タレントプールへ入れる。プールがない場合は作ってから。 %>
<% @talent_pools.each do |talent_pool| %>
  <%= button_to t(".add_to", name: talent_pool.name),
                organization_talent_pool_members_path(locale: I18n.locale,
                                                      organization_id: @organization,
                                                      talent_pool_id: talent_pool,
                                                      candidate_profile_id: candidate_profile),
                method: :post,
                class: "button button--quiet" %>
<% end %>
      </li>
    <% end %>
  </ul>

  <%= render "shared/pagination", pagination: @pagination,
             permitted: Organizations::CandidateSearchesController::SEARCH_KEYS + %i[page locale organization_id] %>
<% else %>
  <p><%= t(".empty") %></p>
<% end %>
