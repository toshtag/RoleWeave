<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<h1><%= t(".title") %></h1>

<% if @organizations.any? %>
  <ul>
    <% @organizations.each do |organization| %>
      <li>
        <%= organization.name %>
        <%= link_to t(".members"),
                    organization_memberships_path(locale: I18n.locale, organization_id: organization) %>
<%= link_to t(".candidate_searches"),
            organization_candidate_searches_path(locale: I18n.locale, organization_id: organization) %>
<%= link_to t(".talent_pools"),
            organization_talent_pools_path(locale: I18n.locale, organization_id: organization) %>
<%= link_to t(".scouts"),
            organization_scouts_path(locale: I18n.locale, organization_id: organization) %>
        <%= link_to t(".webhooks"),
                    organization_webhooks_path(locale: I18n.locale, organization_id: organization) %>
        <%= link_to t(".job_postings"),
                    organization_job_postings_path(locale: I18n.locale, organization_id: organization) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".empty") %></p>
<% end %>

<p><%= link_to t(".new"), new_organization_path(locale: I18n.locale) %></p>
