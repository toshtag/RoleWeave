<% content_for :title, "#{t(".title")} | #{t("application.name")}" %>

<% content_for :robots, "noindex, nofollow" %>

<h1><%= t(".title") %></h1>

<% if flash[:alert] %>
  <p class="form-error" role="alert"><%= flash[:alert] %></p>
<% end %>

<p><%= t(".body") %></p>

<%= form_with url: organization_talent_pools_path(locale: I18n.locale, organization_id: @organization),
              method: :post, class: "form" do |form| %>
  <div class="form__field">
    <%= form.label :name, t(".name") %>
    <%= form.text_field :name, required: true %>
  </div>
  <%= form.submit t(".create"), class: "button" %>
<% end %>

<% if @talent_pools.any? %>
  <ul>
    <% @talent_pools.each do |talent_pool| %>
      <li>
        <%= link_to talent_pool.name,
                    organization_talent_pool_path(locale: I18n.locale,
                                                  organization_id: @organization, id: talent_pool) %>
        <%= t(".members", count: talent_pool.searchable_members.size) %>
        <%= button_to t(".destroy"),
                      organization_talent_pool_path(locale: I18n.locale,
                                                    organization_id: @organization, id: talent_pool),
                      method: :delete,
                      class: "button button--quiet" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".empty") %></p>
<% end %>

<p>
  <%= link_to t(".search"),
              organization_candidate_searches_path(locale: I18n.locale, organization_id: @organization) %>
</p>
