#!/usr/bin/env bash
# コンテナ起動時の前処理。
#
# 依存インストールと DB 準備はここで行わない。
# PostgreSQL の待機は Compose の depends_on / service_healthy に委ねる。
set -euo pipefail

# Puma の PID ファイルはここで削除しない。
#
# entrypoint はすべてのコンテナで走る。docker compose up のサーバーだけでなく、
# docker compose run --rm の一時コンテナでも走る。
# 作業ツリーは bind mount のため、tmp/pids は両者で共有されている。
# 無条件に削除すると、一時コマンドを 1 回動かすだけで
# 動作中のサーバーの PID ファイルが消える。
#
# 削除する側の理由も無い。Rails 8.1.3.1 / Puma 8.0.2 で実測した。
#
#   残骸（存在しない PID）を置いて起動   起動し、PID ファイルを上書きする
#   動作中の PID がある状態で 2 つ目     A server is already running (pid: ...)
#
# 残骸は起動を妨げず、動作中の PID は二重起動を止める。
# 削除は前者を守っておらず、後者の判定だけを壊していた。

exec "$@"
