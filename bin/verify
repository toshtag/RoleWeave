#!/usr/bin/env bash
# 統一検証コマンド。
#
# 正規の実行方法は次の 2 つだけとする。
#
#   docker compose run --rm app bin/verify   アプリケーションの標準検証
#   bin/verify --full                        Docker 基盤と冪等性を含む P0 完全検証
#
# scripts/verify-p0 と scripts/verify-p0-docker は --full から呼ばれる内部実装であり、
# 利用者と CI が直接実行する入口にはしない。
#
# 標準モードは検証だけを行う。
# 依存関係のインストール、lockfile の更新、development データベースの変更、
# サーバーの起動は行わない。準備は bin/setup の責務とする。
#
# 各検査は関数などの間接層を挟まず、トップレベルで直接実行する。
# 実行を共通関数へ委ねると、その関数を無処理にするだけで全検査を飛ばせてしまい、
# 「検査が書かれていること」と「検査が実行されること」が一致しなくなる。
# 直接実行であれば、失敗は set -e の通常の失敗伝播でそのまま非ゼロ終了になる。
set -euo pipefail

APP_ROOT="$(
  cd "$(dirname "${BASH_SOURCE[0]}")/.."
  pwd
)"

cd "$APP_ROOT"

# 完全モードは P0 の累積検証へ委譲する。
# 検証内容をここへ複製すると、正本が 2 つになる。
if [[ "$#" -eq 1 && "$1" == "--full" ]]; then
  exec scripts/verify-p0
fi

# 未知の引数を黙って無視しない。
if [[ "$#" -ne 0 ]]; then
  printf '使用方法: bin/verify [--full]\n' >&2
  exit 1
fi

printf '\n== Ruby 依存関係 ==\n'
bundle check

# Rails コードの静的セキュリティ検査。
# 実行バージョンは Gemfile.lock で固定する。新しい Brakeman の公開そのものは
# 失敗条件にしない（bin/brakeman は --ensure-latest を付与しない）。
printf '\n== セキュリティ静的解析 ==\n'
bin/brakeman --no-pager

# 依存関係の既知脆弱性検査。
#
# advisory database を更新してから Gemfile.lock を監査する。
# 更新には外部通信と git が必要であり、取得・更新に失敗した場合はこの検証も失敗する。
# 古い database へ黙って退避して成功扱いにすると、検査した事実を保証できなくなる。
printf '\n== 依存関係の脆弱性 ==\n'
bin/bundler-audit check --update

printf '\n== Ruby スタイル ==\n'
bin/rubocop

printf '\n== test データベース準備 ==\n'
env RAILS_ENV=test bin/rails db:prepare

printf '\n== Zeitwerk ==\n'
env RAILS_ENV=test bin/rails zeitwerk:check

# 実行時間の長い検証を最後へ置き、静的な契約違反を先に失敗させる。
printf '\n== Rails test ==\n'
env RAILS_ENV=test bin/rails test

printf '\n== 検証完了 ==\n'
