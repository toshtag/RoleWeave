#!/usr/bin/env ruby
# 開発環境のセットアップ。
#
# 正規の実行方法は次のとおり。
#
#   docker compose run --rm app bin/setup
#
# このスクリプトは Ruby 依存関係と development データベースを準備して終了する。
# 開発サーバーの起動は docker compose up の責務とし、ここでは行わない。
# プロセスを置き換えて常駐すると、上記の一時コンテナが終了しなくなる。
#
# 何度実行しても同じ開発可能な状態へ収束させる。
# 既存データ、依存定義、追跡対象ファイルを破壊しない。
# 破壊的な作り直しが必要な場合は、利用者が Rails の DB コマンドを明示的に実行する。

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

# lockfile を変更できない状態で依存を解決する。
# Dockerfile と同じ条件を保ち、イメージとリポジトリの依存を一致させる。
BUNDLE_ENVIRONMENT = { "BUNDLE_FROZEN" => "true" }.freeze

# コマンドは配列形式で渡し、shell の解釈を経由させない。
def system!(*command, environment: {})
  system(environment, *command, exception: true)
end

# 隠れたオプションで破壊的な操作を提供しない。
# 引数の検査はデータベースへ触れる前に行う。
unless ARGV.empty?
  warn "bin/setup は引数を受け付けません。"
  exit 1
end

FileUtils.chdir APP_ROOT do
  puts "== Ruby 依存関係を準備 =="

  # 充足済みなら何もしない。不足している場合だけ解決する。
  unless system(BUNDLE_ENVIRONMENT, "bundle", "check")
    system!("bundle", "install", environment: BUNDLE_ENVIRONMENT)
  end

  puts "\n== データベースを準備 =="

  # db:prepare は未作成なら作成し、作成済みなら未適用の migration だけを適用する。
  system!("bin/rails", "db:prepare")

  puts "\n== 古いログと一時ファイルを整理 =="
  system!("bin/rails", "log:clear", "tmp:clear")

  puts "\n== セットアップ完了 =="
end
