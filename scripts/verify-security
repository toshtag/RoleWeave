#!/usr/bin/env ruby
# セキュリティ検査の構造検査。
#
# scripts/verify-p0 から呼び出される。
#
#   scripts/verify-security              リポジトリの作業ツリーを検査する
#   scripts/verify-security path/to/root 指定した作業ツリーを検査する
#
# 引数を受け取れるようにしているのは負の検証のためである。
# 一時ディレクトリへ複製した作業ツリーを検査し、正規のファイルを破壊しない。
#
# ここで検査するのは「検査が呼ばれる形になっていること」だけである。
# 実際に脆弱性がないことは、bin/verify が Brakeman と bundler-audit を
# 実行して確認する。この検証器は、その呼び出しが削除・無効化・任意化されていない
# ことを保証する。検査の呼び出しを外した変更は、ここで失敗しなければならない。

require "yaml"

REQUIRED_EXECUTABLES = %w[
  bin/verify
  bin/brakeman
  bin/bundler-audit
].freeze

AUDIT_CONFIG_PATH = "config/bundler-audit.yml"

# 実在しない advisory を除外し続けると、除外一覧そのものが審査されなくなる。
# Rails の生成物に含まれる placeholder を名指しで拒否する。
AUDIT_CONFIG_PLACEHOLDER = "CVE-THAT-DOES-NOT-APPLY"

# Brakeman のバージョン確認を検証の成功条件にしない。
# 新しい Brakeman が公開されただけで、同じコミットの検証結果が変わってしまう。
REJECTED_BRAKEMAN_ARGUMENT = "--ensure-latest"

# shell の block を開閉するキーワード。
# セキュリティ検査が条件分岐の内側へ移されていないことを、入れ子の深さで判定する。
BLOCK_OPENERS = %w[if for while until case].freeze
BLOCK_CLOSERS = %w[fi done esac].freeze

# Git 追跡を拒否する path。
#
# これは path ベースの制御である。リポジトリ内の秘密情報を網羅的に検出するものではない。
# ソースコードへ直接書かれた API キーや、Git 履歴に残った過去の秘密情報は対象外とする。
# 内容ベース・履歴ベースの検査は別の仕組みが必要であり、ここでは扱わない。
#
# 現在の P0 方針では Rails credentials を使用しないため、暗号化済みの credentials も
# 追跡対象から除外する。復号鍵を失った暗号文をリポジトリへ残す理由がない。
SECRET_PATH_PATTERNS = [
  ".env",
  ".env.*",
  "config/master.key",
  "config/credentials.yml.enc",
  "config/credentials/*.yml.enc",
  "config/*.key",
  "config/**/*.key"
].freeze

# 先頭のドットを * で一致させるため FNM_DOTMATCH を併用する。
# FNM_PATHNAME がないと、* がディレクトリ区切りをまたいで一致してしまう。
SECRET_PATH_MATCH_FLAGS = File::FNM_PATHNAME | File::FNM_DOTMATCH

def check(failures, condition, message)
  failures << message unless condition
end

# コメント行と空行を除いた実行行を返す。
#
# 行末コメントは除去しない。単純に # 以降を削ると、引用符の内側にある #
# まで削ってしまい、実行内容を取り違える。
def executable_lines(source)
  source.lines.map(&:chomp).reject do |line|
    line.strip.empty? || line.lstrip.start_with?("#")
  end
end

# 各実行行と、その行が置かれた block の深さの組を返す。
#
# 深さ 0 は、無条件に実行される位置であることを意味する。
# 存在確認だけでは、if で囲って任意化した検査を検出できない。
def lines_with_block_depth(lines)
  depth = 0

  lines.map do |line|
    first_token = line.split(/\s+/).reject(&:empty?).first.to_s

    closing = BLOCK_CLOSERS.include?(first_token) || first_token == "}"
    depth -= 1 if closing

    current_depth = depth

    depth += 1 if BLOCK_OPENERS.include?(first_token)
    depth += 1 if line.include?("()") && line.rstrip.end_with?("{")

    [ line, current_depth ]
  end
end

# 検査コマンドの呼び出しを、行単位で 1 件だけ許可する。
#
# 欠落と重複の両方を失敗として扱う。重複を許すと、片方を握り潰した呼び出しを
# 追加しても検出できない。
def verify_security_step(failures, entries, label, pattern, binstub, required_arguments)
  matched = entries.select { |line, _depth| line.match?(pattern) }

  unless matched.length == 1
    failures << "bin/verify must invoke #{label} exactly once, found #{matched.length}"
    matched.each { |line, _depth| failures << "  #{line.strip}" }
    return
  end

  line, depth = matched.first
  stripped = line.strip

  check(
    failures,
    line.include?(binstub),
    "#{label} must be invoked through #{binstub}: #{stripped}"
  )

  required_arguments.each do |argument|
    check(
      failures,
      line.include?(argument),
      "#{label} must be invoked with #{argument.inspect}: #{stripped}"
    )
  end

  # || による代替実行は、検査の失敗を成功へ変換する。
  # advisory database を更新できない状態を成功扱いしないため、握り潰しを拒否する。
  check(
    failures,
    !line.include?("||"),
    "#{label} must not suppress its failure: #{stripped}"
  )

  check(
    failures,
    depth.zero?,
    "#{label} must run unconditionally, found it nested at depth #{depth}: #{stripped}"
  )
end

unless ARGV.length <= 1
  warn "使用方法: scripts/verify-security [path/to/root]"
  exit 1
end

root = ARGV.fetch(0, ".")
failures = []

# --- 実行ファイル -------------------------------------------------------------

REQUIRED_EXECUTABLES.each do |relative_path|
  path = File.join(root, relative_path)

  unless File.file?(path)
    failures << "required file is missing: #{relative_path}"
    next
  end

  check(failures, File.executable?(path), "#{relative_path} must be executable")
end

# --- Brakeman の binstub ------------------------------------------------------

brakeman_path = File.join(root, "bin/brakeman")

if File.file?(brakeman_path)
  brakeman_body = executable_lines(File.read(brakeman_path, encoding: "UTF-8"))

  offending = brakeman_body.select { |line| line.include?(REJECTED_BRAKEMAN_ARGUMENT) }

  check(
    failures,
    offending.empty?,
    "bin/brakeman must not pass #{REJECTED_BRAKEMAN_ARGUMENT}: #{offending.map(&:strip).join(" / ")}"
  )
end

# --- 統一検証の構造 -----------------------------------------------------------

verify_path = File.join(root, "bin/verify")

if File.file?(verify_path)
  verify_body = executable_lines(File.read(verify_path, encoding: "UTF-8"))
  entries = lines_with_block_depth(verify_body)

  verify_security_step(
    failures,
    entries,
    "Brakeman",
    /brakeman/i,
    "bin/brakeman",
    []
  )

  # advisory database を更新してから監査する。
  # 更新なしの check は、取得済みの古い database に対する監査になる。
  verify_security_step(
    failures,
    entries,
    "bundler-audit",
    /bundler-audit/i,
    "bin/bundler-audit",
    [ "check --update" ]
  )

  # set +e 以降は、コマンドの失敗が検証の失敗にならない。
  offending = verify_body.select { |line| line.match?(/(\A|[^[:alnum:]_])set[[:space:]]+\+e/) }

  check(
    failures,
    offending.empty?,
    "bin/verify must not disable failure propagation: #{offending.map(&:strip).join(" / ")}"
  )
end

# --- bundler-audit の除外設定 -------------------------------------------------

audit_config_path = File.join(root, AUDIT_CONFIG_PATH)

if File.file?(audit_config_path)
  raw = File.read(audit_config_path, encoding: "UTF-8")

  check(
    failures,
    !raw.include?(AUDIT_CONFIG_PLACEHOLDER),
    "#{AUDIT_CONFIG_PATH} must not keep the placeholder #{AUDIT_CONFIG_PLACEHOLDER}"
  )

  document =
    begin
      YAML.safe_load(raw, aliases: false, permitted_classes: [])
    rescue Psych::Exception => error
      failures << "#{AUDIT_CONFIG_PATH} must be valid YAML: #{error.message}"
      nil
    end

  if document
    if document.is_a?(Hash)
      # 未知のトップレベル設定を黙って許容しない。
      # 綴りを誤った ignore は、除外が効いていないことに気づけないまま残る。
      check(
        failures,
        document.keys.sort == [ "ignore" ],
        "#{AUDIT_CONFIG_PATH} must define exactly one key ignore, got #{document.keys.sort.inspect}"
      )

      ignored = document["ignore"]

      if ignored.is_a?(Array)
        # 現在の P0 契約では、実在する advisory の除外も許可しない。
        # 除外が必要になった時点で、根拠と再確認期限を伴う契約変更を行う。
        check(
          failures,
          ignored.empty?,
          "#{AUDIT_CONFIG_PATH} ignore must be empty, got #{ignored.inspect}"
        )
      else
        failures << "#{AUDIT_CONFIG_PATH} ignore must be an array, got #{ignored.class}"
      end
    else
      failures << "#{AUDIT_CONFIG_PATH} must be a mapping, got #{document.class}"
    end
  end
else
  failures << "required file is missing: #{AUDIT_CONFIG_PATH}"
end

# --- 開発イメージの前提 -------------------------------------------------------
#
# bundler-audit は advisory database の取得・更新に git を使用する。
# git のない開発イメージでは、標準検証が Docker 内で成立しない。
# ここは静的な検査とし、実際に実行できることは scripts/verify-p0-docker が実測する。

dockerfile_path = File.join(root, "Dockerfile")

if File.file?(dockerfile_path)
  dockerfile_body = executable_lines(File.read(dockerfile_path, encoding: "UTF-8"))

  installs_git = dockerfile_body.any? { |line| line.match?(/\A\s*git\s*\\?\z/) }

  check(
    failures,
    installs_git,
    "Dockerfile must install git for the bundler-audit advisory database"
  )
else
  failures << "required file is missing: Dockerfile"
end

# --- 秘密情報として扱う path ---------------------------------------------------
#
# 判定するのは Git 追跡の有無であり、作業ツリー上の存在ではない。
# 手元にあるだけの Git 管理外ファイルは、新規 clone にも CI にも存在しない。
# リポジトリの契約は、追跡されているものだけで決まる。
#
# path は NUL 区切りで受け取る。改行やスペースを含む path でも境界を取り違えない。

tracked_paths =
  IO.popen([ "git", "-C", root, "ls-files", "-z" ], err: File::NULL, &:read)

if $?.success?
  offending = tracked_paths.split("\0").select do |path|
    SECRET_PATH_PATTERNS.any? do |pattern|
      File.fnmatch?(pattern, path, SECRET_PATH_MATCH_FLAGS)
    end
  end

  # 1 件目で打ち切らず、拒否した path をすべて診断へ出す。
  # 1 件ずつしか分からないと、修正と再実行を件数分繰り返すことになる。
  unless offending.empty?
    failures << "secret paths must not be tracked by Git (#{offending.length} found)"
    offending.sort.each { |path| failures << "  #{path}" }
  end
else
  failures << "failed to list tracked files with git: #{root}"
end

unless failures.empty?
  failures.each { |failure| warn("security contract violation: #{failure}") }
  exit 1
end
