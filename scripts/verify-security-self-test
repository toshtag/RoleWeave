#!/usr/bin/env ruby
# scripts/verify-security の回帰検査と、bin/verify の実行時検査。
#
# scripts/verify-p0 から呼び出される。
#
# 検証は 2 段構えとする。
#
#   構造の変異検査  正規の作業ツリーへ変異を加え、scripts/verify-security が
#                   すべて拒否することを確認する
#   実行時プローブ  スタブを置いた一時環境で bin/verify を実行し、
#                   各検査が実際に呼ばれ、失敗が伝播することを確認する
#
# 構造検査だけでは「そう書かれていること」しか保証できない。
# 逆に実行時プローブだけでは、正規の書き方から外れた実装を拒否できない。
# 片方だけでは、検査を素通りさせる書き方が残る。
#
# 変異は一時ディレクトリへ複製した作業ツリーに対してのみ行う。
# リポジトリの Dockerfile、bin/、config/ は読み取るだけで、書き換えない。
#
# 変異ごとに複製をやり直す。前のケースの変更を次のケースへ持ち越すと、
# どの変異が拒否されたのか分からなくなる。

require "fileutils"
require "tmpdir"

VERIFIER_PATH = "scripts/verify-security"

# 正規の作業ツリーから複製する対象。
# scripts/verify-security が検査する範囲と一致させる。
SOURCE_FILES = %w[
  Dockerfile
  .gitignore
  bin/verify
  bin/brakeman
  bin/bundler-audit
  config/bundler-audit.yml
].freeze

BRAKEMAN_COMMAND = "bin/brakeman --no-pager"
AUDIT_COMMAND = "bin/bundler-audit check --update"

# 利用者の global 設定に依存しない一時リポジトリを作る。
# core.excludesFile などの手元設定で結果が変わると、負の検証が環境依存になる。
GIT_ENV = {
  "GIT_CONFIG_GLOBAL" => File::NULL,
  "GIT_CONFIG_SYSTEM" => File::NULL
}.freeze

def git(root, *arguments)
  system(
    GIT_ENV,
    "git", "-C", root, *arguments,
    exception: true,
    out: File::NULL,
    err: File::NULL
  )
end

# 変異前の作業ツリーを組み立てる。
# 実行権限は検査対象であるため、複製時に保持する。
def prepare(base, name)
  root = File.join(base, name)

  SOURCE_FILES.each do |relative_path|
    destination = File.join(root, relative_path)
    FileUtils.mkdir_p(File.dirname(destination))
    FileUtils.cp(relative_path, destination, preserve: true)
  end

  git(root, "init", "-q")
  git(root, "add", "-A")

  root
end

# 置換が適用されなかった場合は、対象ファイル側の変更に追随できていない。
# 変異していない作業ツリーを「拒否されなかった」と報告すると、
# 検証器が壊れていることを見逃す。適用できない置換は失敗として扱う。
def substitute(root, relative_path, from, to)
  path = File.join(root, relative_path)
  text = File.read(path, encoding: "UTF-8")
  mutated = text.sub(from, to)

  raise "mutation did not change #{relative_path}" if mutated == text

  File.write(path, mutated, encoding: "UTF-8")
end

def rewrite(root, relative_path, text)
  path = File.join(root, relative_path)
  mode = File.stat(path).mode
  File.write(path, text, encoding: "UTF-8")
  File.chmod(mode, path)
end

# .gitignore を迂回して追跡させる。
# 検査対象は Git 追跡の有無であり、作業ツリー上の存在ではない。
def track(root, relative_path)
  path = File.join(root, relative_path)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "self-test probe\n")
  git(root, "add", "-f", relative_path)
end

MUTATIONS = [
  # --- 統一検証からの検査の欠落 -----------------------------------------------
  {
    label: "Brakeman呼び出しの削除",
    apply: ->(root) { substitute(root, "bin/verify", "#{BRAKEMAN_COMMAND}\n", "") },
    expect: "must invoke Brakeman exactly once, found 0"
  },
  {
    label: "bundler-audit呼び出しの削除",
    apply: ->(root) { substitute(root, "bin/verify", "#{AUDIT_COMMAND}\n", "") },
    expect: "must invoke bundler-audit exactly once, found 0"
  },

  # --- 重複 -------------------------------------------------------------------
  #
  # 存在確認だけでは、片方を握り潰した呼び出しを追加しても検出できない。
  {
    label: "Brakeman呼び出しの重複",
    apply: lambda do |root|
      substitute(root, "bin/verify", "#{BRAKEMAN_COMMAND}\n", "#{BRAKEMAN_COMMAND}\n#{BRAKEMAN_COMMAND}\n")
    end,
    expect: "found 2"
  },
  {
    label: "bundler-audit呼び出しの重複",
    apply: lambda do |root|
      substitute(root, "bin/verify", "#{AUDIT_COMMAND}\n", "#{AUDIT_COMMAND}\n#{AUDIT_COMMAND}\n")
    end,
    expect: "found 2"
  },

  # --- advisory database の更新契約 -------------------------------------------
  {
    label: "advisory database更新の省略",
    apply: ->(root) { substitute(root, "bin/verify", AUDIT_COMMAND, "bin/bundler-audit check") },
    expect: "must be invoked as exactly"
  },

  # --- 実行されない書き方 -----------------------------------------------------
  #
  # 行のどこかに binstub 名があることだけを見ると、次はいずれも通過してしまう。
  # 完全一致の契約で拒否する。
  {
    label: "false && によるBrakemanのスキップ",
    apply: ->(root) { substitute(root, "bin/verify", BRAKEMAN_COMMAND, "false && #{BRAKEMAN_COMMAND}") },
    expect: "must be invoked as exactly"
  },
  {
    label: "false && によるbundler-auditのスキップ",
    apply: ->(root) { substitute(root, "bin/verify", AUDIT_COMMAND, "false && #{AUDIT_COMMAND}") },
    expect: "must be invoked as exactly"
  },
  {
    label: "行末コメントへのBrakeman退避",
    apply: ->(root) { substitute(root, "bin/verify", BRAKEMAN_COMMAND, "true # #{BRAKEMAN_COMMAND}") },
    expect: "must be invoked as exactly"
  },
  {
    label: "行末コメントへのbundler-audit退避",
    apply: ->(root) { substitute(root, "bin/verify", AUDIT_COMMAND, "true # #{AUDIT_COMMAND}") },
    expect: "must be invoked as exactly"
  },

  # --- 失敗の握り潰し ---------------------------------------------------------
  {
    label: "bundler-auditの失敗握り潰し",
    apply: ->(root) { substitute(root, "bin/verify", AUDIT_COMMAND, "#{AUDIT_COMMAND} || true") },
    expect: "must be invoked as exactly"
  },
  {
    label: "advisory database更新失敗時の代替実行",
    apply: lambda do |root|
      substitute(root, "bin/verify", AUDIT_COMMAND, "#{AUDIT_COMMAND} || bin/bundler-audit check")
    end,
    expect: "must be invoked as exactly"
  },
  {
    label: "Brakemanの失敗握り潰し",
    apply: ->(root) { substitute(root, "bin/verify", BRAKEMAN_COMMAND, "#{BRAKEMAN_COMMAND} || true") },
    expect: "must be invoked as exactly"
  },
  {
    label: "失敗伝播の無効化",
    apply: ->(root) { substitute(root, "bin/verify", "set -euo pipefail", "set -euo pipefail\nset +e") },
    expect: "must not disable failure propagation"
  },

  # --- 任意化 -----------------------------------------------------------------
  {
    label: "Brakeman呼び出しの条件分岐化",
    apply: lambda do |root|
      substitute(
        root,
        "bin/verify",
        "#{BRAKEMAN_COMMAND}\n",
        %(if [[ "${RUN_SECURITY:-1}" == "1" ]]; then\n#{BRAKEMAN_COMMAND}\nfi\n)
      )
    end,
    expect: "must run unconditionally"
  },
  {
    label: "bundler-audit呼び出しの条件分岐化",
    apply: lambda do |root|
      substitute(
        root,
        "bin/verify",
        "#{AUDIT_COMMAND}\n",
        %(if [[ "${RUN_SECURITY:-1}" == "1" ]]; then\n#{AUDIT_COMMAND}\nfi\n)
      )
    end,
    expect: "must run unconditionally"
  },

  # --- binstub の迂回 ---------------------------------------------------------
  #
  # binstub を経由しないと、lockfile で固定した版が実行される保証がなくなる。
  {
    label: "Brakemanのbinstub迂回",
    apply: ->(root) { substitute(root, "bin/verify", BRAKEMAN_COMMAND, "bundle exec brakeman --no-pager") },
    expect: "must be invoked as exactly"
  },
  {
    label: "bundler-auditのbinstub迂回",
    apply: lambda do |root|
      substitute(root, "bin/verify", AUDIT_COMMAND, "bundle exec bundler-audit check --update")
    end,
    expect: "must be invoked as exactly"
  },

  # --- binstub の中身 ---------------------------------------------------------
  #
  # 実行権限とファイル名だけを見ると、中身を無処理へ置き換えた binstub を
  # 正規のものとして受理してしまう。呼び出しの形は保たれるが、何も検査されない。
  {
    label: "--ensure-latestの復活",
    apply: lambda do |root|
      substitute(
        root,
        "bin/brakeman",
        %(require "bundler/setup"\n),
        %(require "bundler/setup"\n\nARGV.unshift("--ensure-latest")\n)
      )
    end,
    expect: "must not pass --ensure-latest"
  },
  {
    label: "Brakeman binstubの空実装",
    apply: ->(root) { rewrite(root, "bin/brakeman", "#!/usr/bin/env ruby\nexit 0\n") },
    expect: "bin/brakeman must contain exactly the expected executable lines"
  },
  {
    label: "bundler-audit binstubの空実装",
    apply: ->(root) { rewrite(root, "bin/bundler-audit", "#!/usr/bin/env ruby\nexit 0\n") },
    expect: "bin/bundler-audit must contain exactly the expected executable lines"
  },
  {
    label: "Brakeman binstubへの早期終了",
    apply: lambda do |root|
      substitute(root, "bin/brakeman", %(load Gem.bin_path), %(exit 0\nload Gem.bin_path))
    end,
    expect: "bin/brakeman must contain exactly the expected executable lines"
  },
  {
    label: "bundler-audit binstubへの早期終了",
    apply: lambda do |root|
      substitute(root, "bin/bundler-audit", "Bundler::Audit::CLI.start", "exit 0\nBundler::Audit::CLI.start")
    end,
    expect: "bin/bundler-audit must contain exactly the expected executable lines"
  },
  {
    label: "Brakeman binstubの外部コマンド実行",
    apply: lambda do |root|
      substitute(
        root,
        "bin/brakeman",
        %(load Gem.bin_path("brakeman", "brakeman")),
        %(system("brakeman"))
      )
    end,
    expect: "bin/brakeman must contain exactly the expected executable lines"
  },
  {
    label: "bundler-audit設定の読み込み省略",
    apply: lambda do |root|
      substitute(
        root,
        "bin/bundler-audit",
        %(ARGV.concat %w[ --config config/bundler-audit.yml ] if ARGV.empty? || ARGV.include?("check")\n),
        ""
      )
    end,
    expect: "bin/bundler-audit must contain exactly the expected executable lines"
  },
  {
    label: "binstubのshebang改変",
    apply: ->(root) { substitute(root, "bin/brakeman", "#!/usr/bin/env ruby", "#!/bin/sh") },
    expect: "bin/brakeman must use the expected shebang"
  },

  # --- 実行権限 ---------------------------------------------------------------
  {
    label: "bin/brakemanの実行権限剥奪",
    apply: ->(root) { File.chmod(0o644, File.join(root, "bin/brakeman")) },
    expect: "bin/brakeman must be executable"
  },
  {
    label: "bin/bundler-auditの実行権限剥奪",
    apply: ->(root) { File.chmod(0o644, File.join(root, "bin/bundler-audit")) },
    expect: "bin/bundler-audit must be executable"
  },

  # --- bundler-audit の除外設定 -----------------------------------------------
  {
    label: "placeholderのignore追加",
    apply: ->(root) { substitute(root, "config/bundler-audit.yml", "ignore: []", "ignore:\n  - CVE-THAT-DOES-NOT-APPLY") },
    expect: "must not keep the placeholder"
  },
  {
    label: "実在するadvisoryのignore追加",
    apply: ->(root) { substitute(root, "config/bundler-audit.yml", "ignore: []", "ignore:\n  - CVE-2026-66066") },
    expect: "ignore must be empty"
  },
  {
    label: "ignoreを文字列へ変更",
    apply: ->(root) { substitute(root, "config/bundler-audit.yml", "ignore: []", %(ignore: "")) },
    expect: "ignore must be an array"
  },
  {
    label: "ignoreキーの削除",
    apply: ->(root) { substitute(root, "config/bundler-audit.yml", "ignore: []", "{}") },
    expect: "must define exactly one key ignore"
  },
  {
    label: "未知のトップレベル設定の追加",
    apply: ->(root) { substitute(root, "config/bundler-audit.yml", "ignore: []", "ignore: []\nunknown: true") },
    expect: "must define exactly one key ignore"
  },
  {
    label: "設定をYAMLとして壊す",
    apply: ->(root) { substitute(root, "config/bundler-audit.yml", "ignore: []", "ignore: [\n") },
    expect: "must be valid YAML"
  },

  # --- 開発イメージの前提 -----------------------------------------------------
  {
    label: "Dockerfileからgitを削除",
    apply: ->(root) { substitute(root, "Dockerfile", %(      git \\\n), "") },
    expect: "Dockerfile must install git"
  },

  # --- 秘密情報として扱う path ------------------------------------------------
  #
  # それぞれの診断が対象の path を名指しし、他方のケースと取り違えないことまで確認する。
  {
    label: "config/master.keyの追跡",
    apply: ->(root) { track(root, "config/master.key") },
    expect: "config/master.key",
    reject: ".env.local"
  },
  {
    label: ".env.localの追跡",
    apply: ->(root) { track(root, ".env.local") },
    expect: ".env.local",
    reject: "config/master.key"
  },
  {
    label: "credentials.yml.encの追跡",
    apply: ->(root) { track(root, "config/credentials.yml.enc") },
    expect: "config/credentials.yml.enc"
  },
  {
    label: "config配下の鍵ファイルの追跡",
    apply: ->(root) { track(root, "config/credentials/production.key") },
    expect: "config/credentials/production.key"
  },
  {
    label: "複数の秘密情報pathの同時追跡",
    apply: lambda do |root|
      track(root, "config/master.key")
      track(root, ".env.local")
      track(root, "config/credentials.yml.enc")
    end,
    expect: "3 found"
  }
].freeze

# --- 実行時プローブ -------------------------------------------------------------
#
# bin/verify を、外部コマンドをすべてスタブへ置き換えた一時環境で実行する。
# Docker もデータベースも使わないため、完全検証のたびに実行できる。
#
# スタブは呼び出しを記録し、環境変数で終了コードを制御する。
# これにより「検査が実際に呼ばれること」と「失敗が伝播すること」を確認する。

# bin/verify が APP_ROOT からの相対 path で起動する binstub。
PROBE_BINSTUBS = %w[brakeman bundler-audit rubocop rails].freeze

# PATH から解決されるコマンド。
PROBE_PATH_COMMANDS = %w[bundle].freeze

EXPECTED_PROBE_CALLS = [
  "bundle check",
  "brakeman --no-pager",
  "bundler-audit check --update",
  "rubocop",
  "rails db:prepare",
  "rails zeitwerk:check",
  "rails test"
].freeze

def stub_exit_variable(name)
  "STUB_EXIT_#{name.upcase.tr("-", "_")}"
end

def write_stub(path, name)
  File.write(path, <<~SH)
    #!/bin/sh
    printf '%s %s\\n' "#{name}" "$*" >> "$PROBE_LOG"
    exit "${#{stub_exit_variable(name)}:-0}"
  SH

  File.chmod(0o755, path)
end

def prepare_probe(base)
  root = File.join(base, "runtime-probe")
  stub_bin = File.join(base, "runtime-probe-path")

  FileUtils.mkdir_p(File.join(root, "bin"))
  FileUtils.mkdir_p(stub_bin)
  FileUtils.cp("bin/verify", File.join(root, "bin/verify"), preserve: true)

  PROBE_BINSTUBS.each { |name| write_stub(File.join(root, "bin", name), name) }
  PROBE_PATH_COMMANDS.each { |name| write_stub(File.join(stub_bin, name), name) }

  [ root, stub_bin ]
end

def run_probe(root, stub_bin, log_path, stub_exits = {})
  File.write(log_path, "")

  environment = {
    "PATH" => "#{stub_bin}:#{ENV.fetch("PATH")}",
    "PROBE_LOG" => log_path
  }

  stub_exits.each do |name, status|
    environment[stub_exit_variable(name)] = status.to_s
  end

  # 出力には見出しの日本語が含まれる。
  # locale によっては US-ASCII として読み込まれ、UTF-8 の文字列と比較できなくなる。
  output = IO.popen(
    [ environment, File.join(root, "bin/verify") ],
    err: [ :child, :out ],
    &:read
  ).force_encoding("UTF-8")

  calls = File.read(log_path).lines.map(&:strip).reject(&:empty?)

  [ $?.success?, output, calls ]
end

# 検証器の終了コードだけを見る。出力は失敗時の説明と診断の確認に使う。
def verify(root)
  output = IO.popen([ VERIFIER_PATH, root ], err: [ :child, :out ], &:read)
  [ $?.success?, output.force_encoding("UTF-8") ]
end

unless ARGV.empty?
  warn "使用方法: scripts/verify-security-self-test"
  exit 1
end

missing = SOURCE_FILES.reject { |relative_path| File.file?(relative_path) }

unless missing.empty?
  missing.each { |relative_path| warn "required file is missing: #{relative_path}" }
  exit 1
end

failures = []

Dir.mktmpdir("verify-security-self-test") do |base|
  # --- 構造の変異検査 ---------------------------------------------------------

  # 陽性対照。正規の作業ツリーが通過しない検証器は、負の検証も信用できない。
  passed, output = verify(prepare(base, "canonical"))

  failures << "the canonical working tree must pass the structural check:\n#{output}" unless passed

  MUTATIONS.each_with_index do |mutation, index|
    label = mutation.fetch(:label)
    root = prepare(base, "mutation-#{index}")

    begin
      mutation.fetch(:apply).call(root)
    rescue RuntimeError => error
      failures << "mutation #{label.inspect} could not be applied: #{error.message}. update the self test"
      next
    end

    passed, output = verify(root)

    if passed
      failures << "mutation #{label.inspect} must be rejected by #{VERIFIER_PATH}"
      next
    end

    expected = mutation[:expect]

    if expected && !output.include?(expected)
      failures << "mutation #{label.inspect} must report #{expected.inspect}, got:\n#{output}"
    end

    rejected = mutation[:reject]

    if rejected && output.include?(rejected)
      failures << "mutation #{label.inspect} must not report #{rejected.inspect}, got:\n#{output}"
    end
  end

  # --- 実行時プローブ ---------------------------------------------------------

  probe_root, probe_path = prepare_probe(base)
  log_path = File.join(base, "probe.log")

  # すべての検査が成功する場合。
  passed, output, calls = run_probe(probe_root, probe_path, log_path)

  failures << "bin/verify must succeed when every check passes:\n#{output}" unless passed

  unless calls == EXPECTED_PROBE_CALLS
    failures << "bin/verify must run every check exactly once and in order"
    failures << "  expected: #{EXPECTED_PROBE_CALLS.inspect}"
    failures << "  actual:   #{calls.inspect}"
  end

  unless output.include?("検証完了")
    failures << "bin/verify must report completion when every check passes"
  end

  # セキュリティ検査が失敗した場合に、後続を実行せず非ゼロで終わること。
  [
    {
      label: "Brakeman",
      stub: "brakeman",
      status: 31,
      expected_calls: [ "bundle check", "brakeman --no-pager" ]
    },
    {
      label: "bundler-audit",
      stub: "bundler-audit",
      status: 32,
      expected_calls: [ "bundle check", "brakeman --no-pager", "bundler-audit check --update" ]
    }
  ].each do |scenario|
    label = scenario.fetch(:label)

    passed, output, calls = run_probe(
      probe_root,
      probe_path,
      log_path,
      { scenario.fetch(:stub) => scenario.fetch(:status) }
    )

    if passed
      failures << "bin/verify must fail when #{label} fails:\n#{output}"
    end

    unless calls == scenario.fetch(:expected_calls)
      failures << "bin/verify must stop after #{label} fails"
      failures << "  expected: #{scenario.fetch(:expected_calls).inspect}"
      failures << "  actual:   #{calls.inspect}"
    end

    if output.include?("検証完了")
      failures << "bin/verify must not report completion when #{label} fails"
    end
  end
end

unless failures.empty?
  failures.each { |failure| warn("self test failure: #{failure}") }
  exit 1
end
