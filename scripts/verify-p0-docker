#!/usr/bin/env bash
# Docker Compose と PostgreSQL を含む Foundation の検証。
#
# 過去タスクの実行履歴ではなく、現在の Foundation 契約を検証する。
# scripts/verify-p0 から呼ばれる内部実装とする。
#
# 静的検証は docker compose config --format json の正規化結果を Ruby の JSON で解析する。
# YAML のインデントに依存した grep だけでは、値の所属先を取り違える。
#
# 動的検証は専用の Compose project name と空きポートを使い、
# 通常の開発用 project や volume へ影響を与えない。
set -euo pipefail

# 必須の行がちょうど 1 件だけ存在することを確認する。
# 欠落と重複の両方を失敗として扱う。
require_exact_line_once() {
  local expected="$1"
  local file="$2"
  local count

  if [[ ! -f "$file" ]]; then
    printf 'required file is missing: %s\n' "$file" >&2
    return 1
  fi

  count="$(
    awk -v expected="$expected" '
      $0 == expected { count += 1 }
      END { print count + 0 }
    ' "$file"
  )"

  if [[ "$count" -ne 1 ]]; then
    printf \
      'expected exactly one line in %s, found %s: %s\n' \
      "$file" \
      "$count" \
      "$expected" \
      >&2
    return 1
  fi
}

# --- 前提: Docker が使用できること -------------------------------------------

docker info >/dev/null

# --- 前提: 開発用 stack が動いていないこと ------------------------------------
#
# 作業ツリーは bind mount で共有されるため、tmp/pids/server.pid も共有される。
# docker compose up 中のサーバーが置いた PID ファイルがあると、
# 専用の project 名を使っていても、検証用の Rails サーバーは起動を拒否する。
#
#   A server is already running (pid: 6, file: /workspace/tmp/pids/server.pid).
#
# サーバーを起こすのは動的検証の終盤で、そこまでにイメージのビルドと
# コンテナ内の Rails test 1218 件を通る。実測は 88 秒で、
# 出力に残るのは container ... exited (1) の 1 行だけだった。
# PID ファイルにも bind mount にも触れず、直し方も書かれていない。
#
# 落ちること自体は変わらない。変えるのは、何が読めるかと、いつ落ちるかである。

development_server_pid_file=tmp/pids/server.pid

if [[ -s "$development_server_pid_file" ]]; then
  printf \
    'a Rails server pid file exists: %s (pid %s)\n' \
    "$development_server_pid_file" \
    "$(tr -d '\r\n' < "$development_server_pid_file")" \
    >&2
  printf \
    'the working tree is bind mounted, so this verification cannot start its own server\n' \
    >&2
  printf \
    'stop the development stack first: docker compose down\n' \
    >&2
  exit 1
fi

# --- 静的検証: 必須ファイル ---------------------------------------------------

test -f Dockerfile
test -f compose.yaml
test -f .dockerignore
test -x bin/docker-healthcheck
test ! -e docker-compose.yml

# --- 静的検証: Dockerfile -----------------------------------------------------
#
# ベースイメージはパッチバージョンまで固定する。
# ARG の既定値と FROM の参照先の両方を検査し、フローティングタグを拒否する。

require_exact_line_once "ARG RUBY_VERSION=4.0.6" Dockerfile
require_exact_line_once \
  'FROM ruby:${RUBY_VERSION}-slim-bookworm AS development' \
  Dockerfile

unexpected_from="$(
  awk '
    $1 == "FROM" && $2 != "ruby:${RUBY_VERSION}-slim-bookworm" { print $2 }
  ' Dockerfile
)"

if [[ -n "$unexpected_from" ]]; then
  printf 'unexpected base image in Dockerfile: %s\n' "$unexpected_from" >&2
  exit 1
fi

# lockfile を変更できない状態で依存を解決していること。
grep -Fq "BUNDLE_FROZEN=true bundle install" Dockerfile

# 取得物は cache mount へ置き、レイヤーへ残さない。
#
# mount が外れても、ビルドは成功し、イメージも動く。
# 増えるのは毎回の取り直しとイメージの中身だけで、どちらも壊れた形では現れない。
# 静的検査で拒否しないと、黙って元へ戻る。
#
# パターンが -- で始まるため、grep へは -e で渡す。
for cache_target in /var/cache/apt /var/lib/apt/lists; do
  if ! grep -Fq -e "--mount=type=cache,target=${cache_target},sharing=locked" Dockerfile; then
    printf 'Dockerfile must mount a build cache at %s\n' "$cache_target" >&2
    exit 1
  fi
done

# apt の既定は、導入した直後に取得済みの .deb を捨てる。
# cache mount を用意しても、捨てられた後では次のビルドで使えない。
grep -Fq "rm -f /etc/apt/apt.conf.d/docker-clean" Dockerfile
grep -Fq 'Binary::apt::APT::Keep-Downloaded-Packages "true";' Dockerfile

# bundler の cache は Ruby の ABI ごとに分かれる。
# mount の target には ARG を展開できないため、Dockerfile には ABI を直接書いてある。
# RUBY_VERSION を上げたとき、target だけが古いまま残ると、
# 失敗せずに mount が効かなくなる。対応を検査で固定する。
ruby_abi="$(
  awk -F= '
    $1 == "ARG RUBY_VERSION" { split($2, part, "."); print part[1] "." part[2] ".0" }
  ' Dockerfile
)"

if [[ -z "$ruby_abi" ]]; then
  printf 'failed to derive the Ruby ABI from ARG RUBY_VERSION\n' >&2
  exit 1
fi

if ! grep -Fq -e \
  "--mount=type=cache,target=/usr/local/bundle/ruby/${ruby_abi}/cache,sharing=locked" \
  Dockerfile; then
  printf 'Dockerfile must mount the bundler cache for Ruby ABI %s\n' "$ruby_abi" >&2
  exit 1
fi

# Node.js の不在は、Dockerfile の文字列ではなくビルド済みイメージで確認する。
#
# 以前はここで Dockerfile 全体へ node|npm の文字列検査を行っていたが、
# 「導入しない」と書いた説明コメントだけでも失敗する誤検出を起こしていた。
# 契約は「開発イメージに Node.js と npm が存在しないこと」であり、
# 「Dockerfile に文字列が現れないこと」ではない。
# 実測は下段の動的検証が担う。

# 本番向けの処理を開発用イメージへ持ち込まない。
! grep -Fq "assets:precompile" Dockerfile
! grep -Eq 'RAILS_ENV[=:][[:space:]]*production' Dockerfile
! grep -Fq "db:prepare" Dockerfile

# --- 静的検証: .dockerignore --------------------------------------------------

dockerignore_lines=(
  ".git"
  ".bundle"
  "log/*"
  "tmp/*"
  "storage/*"
  "public/assets"
  "!log/.keep"
  "!tmp/.keep"
  "!tmp/pids/.keep"
  "!tmp/storage/.keep"
  "!storage/.keep"
)

for line in "${dockerignore_lines[@]}"; do
  require_exact_line_once "$line" .dockerignore
done

# .context と .local は P0-R2 で撤去したローカルディレクトリ契約である。
# build context の除外対象としても再導入しない。
for removed in .context .local; do
  if grep -Fxq "$removed" .dockerignore; then
    printf '.dockerignore must not ignore %s\n' "$removed" >&2
    exit 1
  fi
done

# 検証スクリプトとプロジェクト文書は build context に残す。
for kept in docs scripts; do
  if awk -v kept="$kept" '
    $0 == kept || $0 == kept "/" || $0 == kept "/*" || $0 == "/" kept { found = 1 }
    END { exit found ? 0 : 1 }
  ' .dockerignore; then
    printf '.dockerignore must not exclude %s\n' "$kept" >&2
    exit 1
  fi
done

# --- 静的検証: 秘密情報が build context へ入らないこと -------------------------
#
# パターンの綴りではなく、実際に入るかどうかで判定する。
# .dockerignore のパターンは path 全体と照合するため、
# .env* と config/*.key は先頭階層にしか当たらない。
# 綴りを一覧で固定していたときは、この 2 行が揃っていることを確認したうえで
# config/.env と config/credentials/*.key を通していた。
#
# 判定には、リポジトリの .dockerignore だけを持ち込んだ使い捨ての context を使う。
# 実在の config/ へダミーの鍵を置かない。
#
# 対象は scripts/verify-security が Git 追跡を拒否している path に合わせる。

secret_probe_paths=(
  ".env"
  ".env.production"
  "config/.env"
  "config/master.key"
  "config/credentials/production.key"
  "config/credentials.yml.enc"
  "config/credentials/production.yml.enc"
)

secret_probe_context="$(mktemp -d)"

# ベースイメージは Dockerfile と同じものを使い、ここで別の版を持ち込まない。
secret_probe_ruby_version="$(
  awk -F= '$1 == "ARG RUBY_VERSION" { print $2 }' Dockerfile
)"

if [[ -z "$secret_probe_ruby_version" ]]; then
  printf 'failed to read ARG RUBY_VERSION from Dockerfile\n' >&2
  exit 1
fi

mkdir -p "$secret_probe_context/config/credentials"

for probe_path in "${secret_probe_paths[@]}"; do
  printf 'probe\n' > "$secret_probe_context/$probe_path"
done

printf \
  'FROM ruby:%s-slim-bookworm\nCOPY . /ctx\n' \
  "$secret_probe_ruby_version" \
  > "$secret_probe_context/Dockerfile"

find_secrets_in_context() {
  local tag="$1"

  docker build --quiet --tag "$tag" "$secret_probe_context" >/dev/null
  docker run --rm "$tag" \
    sh -c 'find /ctx -type f \( -name "*.key" -o -name ".env*" -o -name "*.yml.enc" \) | sort' \
    | tr -d '\r'
}

cleanup_secret_probe() {
  docker image rm --force \
    roleweave-secret-probe-ignored \
    roleweave-secret-probe-control \
    >/dev/null 2>&1 || true
  rm -rf "$secret_probe_context"
}

trap cleanup_secret_probe EXIT

# 対照を先に取る。probe を置き忘れた context では、
# 除外の検査は何もしなくても成功してしまう。
leaked_without_ignore="$(find_secrets_in_context roleweave-secret-probe-control)"

for probe_path in "${secret_probe_paths[@]}"; do
  if ! printf '%s\n' "$leaked_without_ignore" | grep -Fxq "/ctx/$probe_path"; then
    printf 'the secret probe is not exercising %s\n' "$probe_path" >&2
    exit 1
  fi
done

# 本番の .dockerignore を持ち込んで、同じ context を作り直す。
cp .dockerignore "$secret_probe_context/.dockerignore"
leaked_with_ignore="$(find_secrets_in_context roleweave-secret-probe-ignored)"

if [[ -n "$leaked_with_ignore" ]]; then
  printf '.dockerignore must keep secrets out of the build context:\n%s\n' \
    "$leaked_with_ignore" >&2
  exit 1
fi

cleanup_secret_probe
trap - EXIT

# --- 静的検証: config/database.yml -------------------------------------------
#
# 接続先は環境変数で与える。Docker 固有のホスト名や資格情報を設定ファイルへ書かない。

for variable in DATABASE_HOST DATABASE_PORT DATABASE_USERNAME DATABASE_PASSWORD; do
  if ! grep -Fq "$variable" config/database.yml; then
    printf 'config/database.yml must reference %s\n' "$variable" >&2
    exit 1
  fi
done

grep -Eq '^[[:space:]]+database:[[:space:]]*role_weave_development$' config/database.yml
grep -Eq '^[[:space:]]+database:[[:space:]]*role_weave_test$' config/database.yml

if grep -Eq '^[[:space:]]*host:[[:space:]]*db[[:space:]]*$' config/database.yml; then
  printf 'config/database.yml must not hardcode the Docker hostname\n' >&2
  exit 1
fi

# --- 静的検証: bin/setup ------------------------------------------------------
#
# 動的検証は build とコンテナ起動を伴うため、契約違反はその前に失敗させる。

test -x bin/setup
ruby -c bin/setup >/dev/null

# lockfile を変更できない状態で解決していること。
grep -Fq 'BUNDLE_FROZEN' bin/setup
grep -Fq '"bin/rails", "db:prepare"' bin/setup

if grep -Fq 'db:reset' bin/setup; then
  printf 'bin/setup must not run db:reset\n' >&2
  exit 1
fi

if grep -Fq 'bin/dev' bin/setup; then
  printf 'bin/setup must not start bin/dev\n' >&2
  exit 1
fi

# プロセス置換で常駐すると docker compose run --rm が終了しない。
if grep -Eq '(^|[^[:alnum:]_])exec([[:space:](]|$)' bin/setup; then
  printf 'bin/setup must not replace itself with a server process\n' >&2
  exit 1
fi

if grep -Eq 'rails([[:space:]]+|", ")server' bin/setup; then
  printf 'bin/setup must not start the Rails server\n' >&2
  exit 1
fi

# log:clear が空にするのは log/*.log だけである。
# Rails が回転させた log/*.log.0 は掛からず、整理したと表示したまま残る。
# 実測は下段が行い、ここでは削除そのものが消えていないことを見る。
grep -Fq 'Dir.glob("log/*.log.*")' bin/setup

# --- 静的検証: entrypoint を持たないこと ---------------------------------------
#
# ENTRYPOINT の層は ADR 0066 で撤去した。
# コンテナへ渡したコマンドは、間に何も挟まずそのまま実行する。
#
# 前処理を足したくなったときに、まずここへ 1 行だけ書く形へ戻りやすい。
# 戻すこと自体は判断だが、黙って戻ることは拒否する。

if grep -Eq '^[[:space:]]*ENTRYPOINT' Dockerfile; then
  printf 'Dockerfile must not declare an ENTRYPOINT (ADR 0066)\n' >&2
  exit 1
fi

if [[ -e bin/docker-entrypoint ]]; then
  printf 'bin/docker-entrypoint must not exist (ADR 0066)\n' >&2
  exit 1
fi

# --- 静的検証: Compose 定義 ---------------------------------------------------

if grep -Eq '^version:' compose.yaml; then
  printf 'compose.yaml must not declare a top-level version key\n' >&2
  exit 1
fi

# project 名を宣言しないと、Compose は作業ディレクトリ名から導出する。
# clone 先の名前を変えるだけで container・network・volume の名前が変わり、
# 既存の roleweave_postgres_data を持ったまま別の project へ切り替わる。
require_exact_line_once "name: roleweave" compose.yaml

docker compose config --quiet

compose_json="$(mktemp)"
trap 'rm -f "$compose_json"' EXIT

docker compose config --format json > "$compose_json"

ruby - "$compose_json" <<'RUBY'
require "json"

config = JSON.parse(File.read(ARGV.fetch(0)))
failures = []

def check(failures, condition, message)
  failures << message unless condition
end

# Compose の正規化結果は "15s" や "500ms" のような文字列で返る。
# 数値部分だけを比べると、単位の違う値を取り違える。
UNIT_IN_MILLISECONDS = {
  "ns" => 0.000001,
  "us" => 0.001,
  "ms" => 1,
  "s" => 1_000,
  "m" => 60_000,
  "h" => 3_600_000
}.freeze

def duration_ms(value)
  text = value.to_s.strip
  return nil if text.empty?

  parts = text.scan(/(\d+(?:\.\d+)?)(ns|us|ms|s|m|h)/)
  return nil if parts.empty?

  # 単位の無い数字や未知の接尾辞が混ざった値は、解釈せずに拒否する。
  return nil unless parts.map { |amount, unit| "#{amount}#{unit}" }.join == text

  parts.sum { |amount, unit| amount.to_f * UNIT_IN_MILLISECONDS.fetch(unit) }
end

services = config.fetch("services", {})
check(failures, services.keys.sort == %w[app db], "services must be exactly app and db, got #{services.keys.sort.inspect}")

# 表示される名前は、置き場所の都合で変わらないこと。
# 正規化結果の name と、そこから導出される volume 名の両方を見る。
check(failures, config["name"] == "roleweave", "compose project name must be roleweave, got #{config["name"].inspect}")

# network の表示名は project 名そのものとする。
# 既定の roleweave_default から _default を落とすために固定の文字列を書くと、
# --project-name を変えても同じ network を指し、隔離した検証が開発の stack と同居する。
networks = config.fetch("networks", {})
check(failures, networks.keys == %w[default], "compose must declare exactly the default network, got #{networks.keys.inspect}")
check(failures, (networks["default"] || {})["name"] == config["name"], "default network name must follow the project name, got #{(networks["default"] || {})["name"].inspect}")

app = services["app"] || {}
db = services["db"] || {}

# app: ビルド結果に付ける名前
#
# 宣言しないと Compose は project 名とサービス名から導出する。
# 検証は専用の project 名を使うため、導出に任せると
# 同じ中身のイメージが実行中ずっと 2 件並ぶ。
check(failures, app["image"] == "roleweave:development", "app image must be roleweave:development, got #{app["image"].inspect}")

# app: build target と固定バージョン
build = app["build"] || {}
check(failures, build["target"] == "development", "app build target must be development, got #{build["target"].inspect}")
check(failures, (build["args"] || {})["RUBY_VERSION"] == "4.0.6", "app build arg RUBY_VERSION must be 4.0.6")
check(failures, !(build["args"] || {}).key?("NODE_VERSION"), "app build must not declare NODE_VERSION")

# db: 固定イメージ
check(failures, db["image"] == "postgres:18.4-bookworm", "db image must be postgres:18.4-bookworm, got #{db["image"].inspect}")

# db: ホストへポートを公開しない
check(failures, Array(db["ports"]).empty?, "db must not publish ports to the host")

# app: ループバックだけへ公開する。
# ホスト IP を省略すると Docker はすべてのホストインターフェースへバインドする。
app_ports = Array(app["ports"])
check(failures, app_ports.length == 1, "app must publish exactly one port, got #{app_ports.inspect}")

app_port = app_ports.first || {}
check(failures, app_port["host_ip"] == "127.0.0.1", "app port must bind to 127.0.0.1, got #{app_port["host_ip"].inspect}")
check(failures, app_port["target"].to_i == 3000, "app container port must be 3000, got #{app_port["target"].inspect}")
check(failures, app_port["protocol"].to_s.empty? || app_port["protocol"] == "tcp", "app port protocol must be tcp, got #{app_port["protocol"].inspect}")

# db: PostgreSQL 18 のボリューム位置
db_volumes = Array(db["volumes"])
pgdata = db_volumes.find { |volume| volume["target"].to_s.start_with?("/var/lib/postgresql") }
check(failures, !pgdata.nil?, "db must persist /var/lib/postgresql")
if pgdata
  check(failures, pgdata["target"] == "/var/lib/postgresql", "db volume target must be /var/lib/postgresql (PostgreSQL 18), got #{pgdata["target"].inspect}")
  check(failures, pgdata["type"] == "volume", "db data must use a named volume")
  check(failures, pgdata["source"] == "postgres_data", "db data volume source must be postgres_data")
end
check(failures, db_volumes.none? { |volume| volume["target"].to_s.start_with?("/var/lib/postgresql/data") }, "db must not mount the PostgreSQL 17 layout /var/lib/postgresql/data")

# db: trust 認証を使用しない
db_environment = db["environment"] || {}
check(failures, !db_environment.key?("POSTGRES_HOST_AUTH_METHOD"), "db must not set POSTGRES_HOST_AUTH_METHOD")
check(failures, db_environment["POSTGRES_USER"] == "roleweave", "db POSTGRES_USER must be roleweave")
check(failures, db_environment["POSTGRES_DB"] == "role_weave_development", "db POSTGRES_DB must be role_weave_development")

# app: 起動順序
depends_on = app["depends_on"] || {}
check(failures, depends_on.key?("db"), "app must depend on db")
check(failures, (depends_on["db"] || {})["condition"] == "service_healthy", "app must wait for db service_healthy")

# healthcheck
#
# 起動中と常駐中で間隔を分ける。start_interval が無いと、
# 起動の判定は常駐用の長い interval に律速される。
# 逆に interval を起動に合わせて詰めると、起動が終わった後もその頻度で払い続ける。
# docker compose run の一時コンテナも healthcheck を実行するため、そちらにも効く。
%w[app db].each do |name|
  healthcheck = (services[name] || {})["healthcheck"] || {}
  check(failures, !Array(healthcheck["test"]).empty?, "#{name} must define a healthcheck")
  check(failures, healthcheck["disable"] != true, "#{name} healthcheck must not be disabled")

  interval = duration_ms(healthcheck["interval"])
  start_interval = duration_ms(healthcheck["start_interval"])

  check(failures, !interval.nil?, "#{name} healthcheck must set interval")
  check(failures, !start_interval.nil?, "#{name} healthcheck must set start_interval")

  if interval && start_interval
    check(
      failures,
      start_interval < interval,
      "#{name} healthcheck start_interval must be shorter than interval, got #{healthcheck["start_interval"].inspect} and #{healthcheck["interval"].inspect}"
    )
  end
end

# app: DB 接続環境変数
app_environment = app["environment"] || {}
{
  "DATABASE_HOST" => "db",
  "DATABASE_PORT" => "5432",
  "DATABASE_USERNAME" => "roleweave",
  "DATABASE_PASSWORD" => "roleweave"
}.each do |key, value|
  check(failures, app_environment[key] == value, "app environment #{key} must be #{value.inspect}, got #{app_environment[key].inspect}")
end

# app: bind mount と依存キャッシュ volume の分離
app_volumes = Array(app["volumes"])
workspace = app_volumes.find { |volume| volume["target"] == "/workspace" }
check(failures, workspace && workspace["type"] == "bind", "app must bind mount the working tree at /workspace")

bundle_mount = app_volumes.find { |volume| volume["target"] == "/usr/local/bundle" }
check(failures, bundle_mount && bundle_mount["type"] == "volume" && bundle_mount["source"] == "bundle", "app must mount the named volume bundle at /usr/local/bundle")

check(failures, app_volumes.none? { |volume| volume["type"] == "volume" && volume["source"].to_s.empty? }, "app must not use anonymous volumes")

# named volume
check(failures, config.fetch("volumes", {}).keys.sort == %w[bundle postgres_data], "named volumes must be exactly bundle and postgres_data")

# 運用上の固定を持ち込まない
services.each do |name, service|
  check(failures, !service.key?("restart"), "#{name} must not set a restart policy")
  check(failures, !service.key?("container_name"), "#{name} must not set container_name")
  check(failures, service["platform"].to_s.empty?, "#{name} must not pin platform")
  check(failures, !service.key?("develop"), "#{name} must not configure Compose Watch")
  check(failures, Array(service["profiles"]).empty?, "#{name} must not use profiles")
end

unless failures.empty?
  failures.each { |failure| warn("compose contract violation: #{failure}") }
  exit 1
end
RUBY

# --- 動的検証: 隔離した検証環境 -----------------------------------------------
#
# 通常の開発用 project や volume を壊さないよう、専用の project name を使う。
# ホストポートは実行時に空きポートを取得し、既存プロセスと衝突させない。

project_name="roleweave-p0-verify-$$"

app_port="$(
  ruby -rsocket -e '
    server = TCPServer.new("127.0.0.1", 0)
    puts server.addr[1]
    server.close
  '
)"

compose() {
  APP_PORT="$app_port" docker compose --project-name "$project_name" "$@"
}

cleanup() {
  local status=$?

  # イメージは削除しない。
  #
  # compose.yaml が image を宣言しているため、検証も開発も同じ
  # roleweave:development をビルドする。検証専用のイメージは生まれない。
  #
  # --rmi local はカスタムタグを避けない。実測では、開発の stack が動作中でも
  # roleweave:development を消した。検証のたびに開発用イメージを削り、
  # 次の docker compose up でビルドし直させることになる。
  #
  # 削除する対象は、この project が作った container・network・volume だけとする。
  APP_PORT="$app_port" docker compose \
    --project-name "$project_name" \
    down \
    --volumes \
    --remove-orphans \
    >/dev/null 2>&1 || true

  rm -f "$compose_json"

  return "$status"
}

trap cleanup EXIT

compose build app

# 検証が、それ専用のイメージを作らないこと。
#
# 宣言した image ではなく導出に任せると、ここで
# roleweave-p0-verify-<pid>-app が生まれ、検証が終わるまで docker images に並ぶ。
# 判定は綴りではなく、実際に増えたかどうかで行う。
if docker images --format '{{.Repository}}' | grep -q "^${project_name}-"; then
  printf 'the verification project must not build its own image\n' >&2
  exit 1
fi

# 宣言したタグでビルド結果が存在すること。
docker image inspect roleweave:development >/dev/null

# --- 動的検証: app イメージの中身 ---------------------------------------------
#
# DB を起動せずに確認する。

compose run --rm --no-deps app \
  ruby -e 'abort "unexpected Ruby #{RUBY_VERSION}" unless RUBY_VERSION == "4.0.6"'

container_rails_version="$(compose run --rm --no-deps app bundle exec rails --version | tr -d '\r\n')"
test "$container_rails_version" = "Rails 8.1.3.1"

compose run --rm --no-deps app bundle check

# bundler-audit は advisory database の取得・更新に git を使用する。
# Dockerfile の静的検査だけでは、イメージの中で実際に実行できることを保証できない。
compose run --rm --no-deps app git --version

# 画像処理のライブラリは導入しない（ADR 0064）。イメージへ無いことを実測する。
#
# 以前はここで libvips 8.13 以上を要求していた。CVE-2026-66066 の対策が
# その版を必要としたためである。variant を生成しないと決め、
# gem 側の backend も外したため、要求する対象そのものが無くなった。
#
# 下限の検査を消すだけにすると、ベースイメージの変更や
# 別パッケージの依存で libvips が戻ったときに気付けない。
# 版を検査していた場所は、不在を検査する場所として残す。
#
# 判定には dpkg の導入状態を使う。共有ライブラリの実体は
# 別パッケージの依存として入ることもあり、ファイルの有無だけでは
# 「入れたつもりがない」ことを確かめられない。
if compose run --rm --no-deps app sh -c \
  'dpkg-query -W libvips42 || command -v vips || command -v convert || command -v magick'; then
  printf 'the app image must not contain image processing libraries\n' >&2
  exit 1
fi

# Node.js は P0-R1 で撤去した。イメージへ残っていないことを実測する。
# git を追加した後も、開発基盤を持ち込まない契約は変わらない。
if compose run --rm --no-deps app sh -c 'command -v node || command -v npm'; then
  printf 'the app image must not contain Node.js or npm\n' >&2
  exit 1
fi

# PostgreSQL のクライアントは導入しない。app からは pg gem が libpq を直接呼ぶ。
# libvips と同じく、不在を実測する場所として残す。
if compose run --rm --no-deps app sh -c \
  'dpkg-query -W "postgresql-client*" || command -v psql || command -v pg_dump || command -v pg_restore'; then
  printf 'the app image must not contain the PostgreSQL client tools\n' >&2
  exit 1
fi

# libpq5 は落とさない。pg gem が呼ぶ実体であり、外すと接続そのものができなくなる。
# 「呼ばれないものを落とす」の行き過ぎを、不在の検査と対で止める。
compose run --rm --no-deps app dpkg-query -W libpq5

# 取得物がイメージへ残っていないことを実測する。
# 静的検査は cache mount がそう書いてあることしか示さない。
# 書いてあっても、後段のレイヤーが同じ path へ書き戻せば残る。
compose run --rm --no-deps app sh -c '
  set -eu

  lists="$(find /var/lib/apt/lists -type f | wc -l)"
  if [ "$lists" -ne 0 ]; then
    echo "apt package lists remain in the image: $lists" >&2
    exit 1
  fi

  archives="$(find /var/cache/apt -type f -name "*.deb" | wc -l)"
  if [ "$archives" -ne 0 ]; then
    echo "apt archives remain in the image: $archives" >&2
    exit 1
  fi

  gems="$(find /usr/local/bundle -type f -name "*.gem" -path "*/cache/*" | wc -l)"
  if [ "$gems" -ne 0 ]; then
    echo "downloaded .gem files remain in the image: $gems" >&2
    exit 1
  fi
'

# --- 動的検証: 依存が欠けた状態からのセットアップ ------------------------------
#
# 対象は検証専用 project の named volume だけである。
# db はここで起動しない。正規コマンドと同じく Compose の depends_on に任せる。

compose run --rm --no-deps app sh -c '
  set -eu
  find /usr/local/bundle -mindepth 1 -maxdepth 1 -exec rm -rf {} +
'

# Docker は空の named volume に対して、次のコンテナ作成時にイメージの内容を再投入する。
# 空にするだけでは gem の欠落を再現できず、bundle install の経路を検証できない。
# 再投入された内容から一部だけを取り除き、bundle check を確実に失敗させる。
compose run --rm --no-deps app sh -c '
  set -eu

  gem_dir="$(find /usr/local/bundle/ruby/*/gems -mindepth 1 -maxdepth 1 -type d | sort | head -n 1)"
  test -n "$gem_dir"

  # gemspec を残すと RubyGems は導入済みとして扱う。実体と併せて取り除く。
  rm -rf "$gem_dir"
  rm -f "${gem_dir%/gems/*}/specifications/$(basename "$gem_dir").gemspec"
'

# 復旧を検証する前提が成立していること。
if compose run --rm --no-deps app bundle check; then
  printf 'the verification failed to reproduce a missing dependency\n' >&2
  exit 1
fi

# 作業ツリーは bind mount されている。
# セットアップが追跡対象ファイルや lockfile を書き換えないことを前後比較で確認する。
setup_git_state_before="$(git status --porcelain=v1 --untracked-files=all)"

# 正規コマンドと同じ形で実行する。
# 常駐すると --rm の一時コンテナが終了せず、ここで停止する。
compose run --rm app bin/setup

setup_git_state_after_first="$(git status --porcelain=v1 --untracked-files=all)"
test "$setup_git_state_after_first" = "$setup_git_state_before"

compose run --rm --no-deps app bundle check

# --- 動的検証: PostgreSQL ------------------------------------------------------

compose up -d --wait db

container_server_version="$(
  compose exec -T db \
    psql -U roleweave -d role_weave_development -Atc 'SHOW server_version_num;' \
    | tr -d '\r\n'
)"
test "$container_server_version" = "180004"

# --- 動的検証: bin/setup の冪等性 ----------------------------------------------

psql_development() {
  compose exec -T db \
    psql \
    -U roleweave \
    -d role_weave_development \
    -At \
    -v ON_ERROR_STOP=1 \
    -c "$1"
}

# development データベースの決定的な状態をテキストとして取得する。
# 「2 回目に何もしないこと」ではなく、「2 回目も同じ状態へ収束すること」を確認する。
#
# 業務モデル導入前は schema_migrations と ar_internal_metadata が存在しない。
# 存在の有無そのものも比較対象に含める。
database_state() {
  local tables

  tables="$(
    psql_development "
      SELECT tablename FROM pg_tables
      WHERE schemaname = 'public'
      ORDER BY tablename;
    "
  )"

  printf 'tables:\n%s\n' "$tables"

  if printf '%s\n' "$tables" | grep -qx schema_migrations; then
    printf 'migrations:\n%s\n' \
      "$(psql_development 'SELECT version FROM schema_migrations ORDER BY version;')"
  else
    printf 'migrations: absent\n'
  fi

  if printf '%s\n' "$tables" | grep -qx ar_internal_metadata; then
    printf 'metadata:\n%s\n' \
      "$(psql_development "
        SELECT key || '=' || COALESCE(value, '')
        FROM ar_internal_metadata
        ORDER BY key;
      ")"
  else
    printf 'metadata: absent\n'
  fi

  printf 'probe:\n%s\n' \
    "$(psql_development 'SELECT value FROM setup_idempotency_probe ORDER BY value;')"
}

# 検証専用のテーブルと行。既存の同名テーブルは削除せず、衝突を失敗として扱う。
compose exec -T db \
  psql \
  -U roleweave \
  -d role_weave_development \
  -v ON_ERROR_STOP=1 \
  -q \
  -c "
    CREATE TABLE setup_idempotency_probe (value text PRIMARY KEY);
    INSERT INTO setup_idempotency_probe (value) VALUES ('preserved');
  "

database_state_after_first="$(database_state)"

# Rails が回転させたログを bin/setup が片付けることを実測する。
#
# log:clear が空にするのは log/*.log だけで、log/*.log.0 は掛からない。
# development と test は 100 MB ごとに回転するため、
# 片付けが消えると、整理したと表示したまま 100 MB が残り続ける。
#
# 作業ツリーは bind mount のため、置く場所も消える場所もホスト側になる。
# log/ は .gitignore の対象であり、git の状態の比較には現れない。
rotated_log_probe="log/verify-p0-rotation-probe.log.0"
printf 'rotated\n' > "$rotated_log_probe"

# 同じ project、同じ named volume に対する 2 回目の実行。
compose run --rm app bin/setup

if [[ -e "$rotated_log_probe" ]]; then
  rm -f "$rotated_log_probe"
  printf 'bin/setup must remove rotated log files\n' >&2
  exit 1
fi

setup_git_state_after_second="$(git status --porcelain=v1 --untracked-files=all)"
test "$setup_git_state_after_second" = "$setup_git_state_before"

compose run --rm --no-deps app bundle check

database_state_after_second="$(database_state)"
test "$database_state_after_second" = "$database_state_after_first"

# 状態全体の比較に加えて、検証用の行が残っていることを直接確認する。
probe_value="$(
  psql_development 'SELECT value FROM setup_idempotency_probe;' | tr -d '\r\n'
)"
test "$probe_value" = "preserved"

# 破壊的な操作を隠れたオプションとして提供しない。
for rejected_argument in --reset --skip-server unexpected-argument; do
  if compose run --rm app bin/setup "$rejected_argument"; then
    printf 'bin/setup must reject the argument: %s\n' "$rejected_argument" >&2
    exit 1
  fi
done

# 引数を拒否した後も、既存データが残っていること。
database_state_after_rejected_arguments="$(database_state)"
test "$database_state_after_rejected_arguments" = "$database_state_after_first"

compose exec -T db \
  psql -U roleweave -d role_weave_development -v ON_ERROR_STOP=1 -q -c \
  'DROP TABLE setup_idempotency_probe;'

# --- 動的検証: コンテナ内の標準検証 --------------------------------------------
#
# test DB の準備は bin/verify の責務とする。
# 検証内容をここへ複製せず、正規コマンドをそのまま実測する。
# bin/verify --full をコンテナ内から呼ぶと再帰するため、標準モードだけを実行する。

compose run --rm app bin/verify

compose run --rm app bin/rails runner \
  'abort "unexpected server version" unless ActiveRecord::Base.connection.select_value("SHOW server_version_num").to_i == 180004'

# --- 動的検証: DB の永続化 -----------------------------------------------------
#
# db コンテナを削除して再作成しても、named volume の内容が失われないことを確認する。

compose exec -T db \
  psql -U roleweave -d role_weave_development -v ON_ERROR_STOP=1 -q -c "
    CREATE TABLE docker_persistence_probe (value text NOT NULL);
    INSERT INTO docker_persistence_probe (value) VALUES ('persisted');
  "

compose stop db
compose rm -f db
compose up -d --wait db

probe_value="$(
  compose exec -T db \
    psql -U roleweave -d role_weave_development -Atc \
    'SELECT value FROM docker_persistence_probe;' \
    | tr -d '\r\n'
)"
test "$probe_value" = "persisted"

compose exec -T db \
  psql -U roleweave -d role_weave_development -v ON_ERROR_STOP=1 -q -c \
  'DROP TABLE docker_persistence_probe;'

# --- 動的検証: app の起動と healthcheck ---------------------------------------

compose up -d --wait app

# network が project ごとに分かれていること。
#
# 表示名から _default を落とすために固定の文字列を書くと、
# --project-name を変えても同じ network を指す。
# この検証の app と db が開発中の stack と 1 つの network に同居し、
# サービス名 db がどちらを指すかは起動順で決まることになる。
#
# 判定は綴りではなく、実際に接続されている network の名前で行う。
attached_networks="$(
  compose ps --quiet app |
    xargs docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{"\n"}}{{end}}' |
    grep -v '^$' |
    sort |
    tr '\n' ' '
)"
if [[ "$attached_networks" != "$project_name " ]]; then
  printf \
    'app must attach only to the network of its own project: expected %s, got %s\n' \
    "$project_name" \
    "${attached_networks:-none}" \
    >&2
  exit 1
fi

# 正規化結果だけでなく、実際に公開された endpoint がループバック限定であることを確認する。
published_endpoint="$(compose port app 3000 | tr -d '\r\n')"
test "$published_endpoint" = "127.0.0.1:${app_port}"

ruby -rnet/http -e '
  port = Integer(ARGV.fetch(0))
  response = Net::HTTP.get_response(URI("http://127.0.0.1:#{port}/up"))
  abort "health check failed: #{response.code}" unless response.code == "200"
' "$app_port"

# --- 動的検証: 一時コンテナが動作中のサーバーへ触れないこと --------------------
#
# 作業ツリーは bind mount のため、tmp/pids は up のサーバーと
# run --rm の一時コンテナで共有されている。
#
# 一時コンテナ側が PID ファイルを消すと、一時コマンドを 1 回動かすだけで
# 動作中のサーバーの PID ファイルが消え、二重起動の判定が働かなくなる。
# ADR 0066 で entrypoint を撤去した後も、前処理を足す場所は
# CMD 側にも Compose の command 側にも残っている。
#
# 判定は振る舞いで行う。特定のファイルの文字列を検査すると、
# 「削除しない」と書いた説明コメントだけでも失敗する誤検出になる。

server_pid_before="$(compose exec -T app cat tmp/pids/server.pid | tr -d '\r\n')"

if [[ ! "$server_pid_before" =~ ^[0-9]+$ ]]; then
  printf 'expected a running server pid, got %s\n' "$server_pid_before" >&2
  exit 1
fi

compose run --rm --no-deps app true

server_pid_after="$(
  compose exec -T app sh -c 'cat tmp/pids/server.pid 2>/dev/null || true' | tr -d '\r\n'
)"

if [[ "$server_pid_after" != "$server_pid_before" ]]; then
  printf \
    'a one-off container must not touch the running server pid file: %s => %s\n' \
    "$server_pid_before" \
    "${server_pid_after:-removed}" \
    >&2
  exit 1
fi

# サーバーが動き続けていることも確かめる。
# PID ファイルが残っていても、サーバーが落ちていれば検査の意味がない。
ruby -rnet/http -e '
  port = Integer(ARGV.fetch(0))
  response = Net::HTTP.get_response(URI("http://127.0.0.1:#{port}/up"))
  abort "the server must stay up after a one-off container: #{response.code}" unless response.code == "200"
' "$app_port"

# --- 動的検証: 後片付けが開発用イメージを消さないこと --------------------------
#
# 検証は専用の project を使うが、イメージは宣言したタグを開発側と共有する。
# 後片付けの範囲にイメージを含めると、検証を 1 回動かすだけで
# 開発用イメージが消え、次の docker compose up がビルドからやり直しになる。
#
# 実測では、--rmi local はカスタムタグを避けなかった。
# 開発の stack が動作中でも roleweave:development を削除している。
#
# 検査は cleanup そのものを呼んで行う。同じ down を別に書き写すと、
# cleanup 側にだけ --rmi を戻したときに通ってしまう。

cleanup

docker image inspect roleweave:development >/dev/null

# --- 事後確認: 契約外のファイルを書き換えていないこと --------------------------
#
# 作業ツリーは bind mount されているため、コンテナ内の操作が
# 依存定義を書き換えていないことを最後に確認する。

git diff --quiet HEAD -- \
  Gemfile \
  Gemfile.lock
