#!/usr/bin/env bash
# P0 Project Foundation の累積検証。
#
# P0 のタスクが進むたびに検証を追加していく。
# 各検証は、対応するタスクが開始された時点で自動的に有効になる。
# これにより、実装していないタスクを Code Pact の構造検査だけで完了できない状態を保つ。
#
# P0-T6 以降、このスクリプトは bin/verify --full から呼ばれる内部実装とする。
# 利用者と CI が直接実行する入口にはしない。
set -euo pipefail

# 進捗イベントの有無でタスクの開始を判定する。
# started / done のいずれかが記録されていれば、そのタスクの検証を有効にする。
task_has_event() {
  local task_id="$1"
  grep -Rqs "^task_id: ${task_id}$" .code-pact/state/events
}

# 必須の行がちょうど 1 件だけ存在することを確認する。
# 欠落と重複の両方を失敗として扱う。
# 単純な存在確認では、既存設定を置換した不完全なファイルや、
# 同じ行を繰り返し追記したファイルを検出できない。
require_exact_line_once() {
  local expected="$1"
  local file="$2"
  local count

  if [[ ! -f "$file" ]]; then
    printf 'required file is missing: %s\n' "$file" >&2
    return 1
  fi

  count="$(
    awk -v expected="$expected" '
      $0 == expected { count += 1 }
      END { print count + 0 }
    ' "$file"
  )"

  if [[ "$count" -ne 1 ]]; then
    printf \
      'expected exactly one line in %s, found %s: %s\n' \
      "$file" \
      "$count" \
      "$expected" \
      >&2
    return 1
  fi
}

# --- 開発ランタイム -----------------------------------------------------------
#
# ファイルに書かれたバージョンだけでなく、実際に動いている Node.js を検査する。
# バージョンマネージャーの切り替え漏れを、Code Pact の検証より前に失敗させる。

test -f .node-version

expected_node_version="$(tr -d '\r\n' < .node-version)"

test "$expected_node_version" = "24.18.0"
test "$(node --version)" = "v${expected_node_version}"

node -e '
  const packageJson = require("./package.json");

  if (packageJson.engines?.node !== ">=24.18.0 <25") {
    console.error(
      `unexpected package.json engines.node: ${packageJson.engines?.node}`
    );
    process.exit(1);
  }
'

# --- P0-T2 / P0-T2A / P0-T2B / P0-T2C: Code Pact 制御面 ----------------------
#
# plan lint は必ず strict で実行する。
# --strict でのみ終了コードへ反映される警告（TASK_ID_PHASE_PREFIX など）を見逃さない。

npm run pact:validate >/dev/null
npm run pact:lint >/dev/null

test -f design/brief.md
test -f design/constitution.md
test -f design/rules/coding-style.md
test -f design/rules/code-pact-execution.md
test -f design/acceptance/P0-T3-rails-bootstrap.md
test -f docs/development/code-pact.md

# --- 既存 .gitignore 設定の保持 -----------------------------------------------
#
# P0-T3 で Rails 用の除外設定を追記する際、これらを置換・削除・重複させない。

project_gitignore_lines=(
  "/node_modules/"
  "/.code-pact/locks/"
  "/.code-pact/state/locks/"
  "/.code-pact/cache/"
  "/.local/"
  "/.context/"
)

for line in "${project_gitignore_lines[@]}"; do
  require_exact_line_once "$line" .gitignore
done

# --- P0 全体で持ち込まない生成物 ---------------------------------------------
#
# デプロイ基盤（Kamal）、Thruster、開発用コンテナは現在のロードマップで採用していない。
# Rails が一時生成する master key と、それで暗号化された credentials も持ち込まない。

test ! -e .kamal
test ! -e config/deploy.yml
test ! -e bin/kamal
test ! -e bin/thrust
test ! -e .devcontainer
test ! -e config/master.key
test ! -e config/credentials.yml.enc

# --- P0-T4 以前: Docker 関連ファイルの混入を拒否 -----------------------------

if ! task_has_event "P0-T4"; then
  test ! -e Dockerfile
  test ! -e compose.yaml
  test ! -e docker-compose.yml
  test ! -e .dockerignore
  test ! -e bin/docker-entrypoint
fi

# --- P0-T7: GitHub Actions による統一検証 -------------------------------------
#
# P0-T7 が開始された時点で、混入の拒否から Workflow 契約の検査へ切り替える。
# Workflow 構造検査は Docker build より前へ置き、契約違反を build より先に失敗させる。
# 受け入れ条件の詳細は design/acceptance/P0-T7-github-actions.md を参照する。
#
# bin/ci はローカル検証の入口であり、GitHub Actions ではない。これは開始前も拒否しない。
# bin/verify との関係は P0-T6 の検証で確定する。

if ! task_has_event "P0-T7"; then
  test ! -e .github/workflows
  test ! -e .github/dependabot.yml
else
  test -d .github/workflows
  test -f .github/workflows/ci.yml
  test -x scripts/verify-github-actions
  test -x scripts/verify-github-actions-self-test

  # Dependabot は P0-T9 の非目標であり、P0 では持ち込まない。
  test ! -e .github/dependabot.yml

  # P0 では Workflow を ci.yml の 1 つに限定する。
  # 検証入口が増えると、bin/verify を正本とする委譲経路が成立しなくなる。
  workflow_count="$(
    find .github/workflows -maxdepth 1 -type f | wc -l | tr -d ' '
  )"
  test "$workflow_count" = "1"

  scripts/verify-github-actions

  # 構造検査は「契約違反を拒否できること」まで含めて初めて意味を持つ。
  # 負の検証を実行時の手作業に依存させると、検証器の退行に気づけない。
  scripts/verify-github-actions-self-test
fi

# --- P0-T3: Rails アプリケーションの実体 -------------------------------------
#
# P0-T3 が開始された時点で有効になる。
# 受け入れ条件の詳細は design/acceptance/P0-T3-rails-bootstrap.md を参照する。

if task_has_event "P0-T3"; then
  test -f Gemfile
  test -f Gemfile.lock
  test -f Rakefile
  test -f config.ru
  test -x bin/rails
  test -f config/application.rb
  test -f config/database.yml
  test -d app
  test -d test

  # 固定バージョン。ファイルの内容だけでなく実行中のランタイムを検査する。
  test -f .ruby-version
  test "$(tr -d '\r\n' < .ruby-version)" = "4.0.6"
  test "$(ruby -e 'print RUBY_VERSION')" = "4.0.6"
  test "$(bundle exec rails --version)" = "Rails 8.1.3"

  # --skip-git で生成されない Git 管理ファイルを補っていること
  test -f .gitignore
  test -f .gitattributes
  test -f .rubocop.yml

  # Rails 8.1.3 標準の除外設定。
  # .keep の除外解除がないと、維持すると宣言した .keep が Git 管理対象にならない。
  rails_gitignore_lines=(
    "/.bundle"
    "/.env*"
    "/log/*"
    "!/log/.keep"
    "/tmp/*"
    "!/tmp/.keep"
    "/tmp/pids/*"
    "!/tmp/pids/"
    "!/tmp/pids/.keep"
    "/storage/*"
    "!/storage/.keep"
    "/tmp/storage/*"
    "!/tmp/storage/"
    "!/tmp/storage/.keep"
    "/public/assets"
    "/config/*.key"
  )

  for line in "${rails_gitignore_lines[@]}"; do
    require_exact_line_once "$line" .gitignore
  done

  require_exact_line_once "db/schema.rb linguist-generated" .gitattributes
  require_exact_line_once "vendor/* linguist-vendored" .gitattributes

  grep -Eq 'gem[[:space:]]+["'\'']pg["'\'']' Gemfile
  grep -Eq 'adapter:[[:space:]]*postgresql' config/database.yml
  grep -Eq 'module[[:space:]]+RoleWeave' config/application.rb

  bundle check

  # PostgreSQL サーバーがない状態で boot できることを確認する。
  # 接続不能な DATABASE_URL を与え、boot 中に不用意な DB 接続が起きていないことを検出する。
  env \
    RAILS_ENV=test \
    DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
    PGCONNECT_TIMEOUT=1 \
    bundle exec rails zeitwerk:check

  env \
    RAILS_ENV=test \
    DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
    PGCONNECT_TIMEOUT=1 \
    bundle exec rails runner \
    'abort "unexpected application namespace" unless Rails.application.class.module_parent_name == "RoleWeave"'

  # Rails 生成後、README が事実誤認を残していないこと
  ! grep -Fq 'アプリケーションは実装されていません' README.md
  ! grep -Fq 'application itself has not been implemented' README.en.md
fi

# --- P0-T6: 統一検証コマンド --------------------------------------------------
#
# P0-T6 が開始された時点で有効になる。
# Docker 検証は build とコンテナ起動を伴うため、契約違反はその前に失敗させる。
# 受け入れ条件の詳細は design/acceptance/P0-T6-unified-verification.md を参照する。

if task_has_event "P0-T6"; then
  test -x bin/verify
  test -x bin/ci

  # 検証定義の二重正本を残さない。
  test ! -e config/ci.rb

  bash -n bin/verify
  bash -n bin/ci

  # フェーズ検証コマンドは YAML として解析する。
  # Code Pact の serializer は表記を正規化するため、インデント前提の grep では検出できない。
  ruby -ryaml -e '
    phase = YAML.load_file("design/phases/P0-project-foundation.yaml")
    commands = phase.fetch("verification").fetch("commands")

    abort "unexpected P0 verification command: #{commands.inspect}" \
      unless commands == ["bin/verify --full"]
  '

  # コメント行は検査対象から外す。
  # 正規コマンドを説明するヘッダーコメントと、実際に実行するコマンドを混同しない。
  verify_body="$(grep -v '^[[:space:]]*#' bin/verify)"

  required_verify_commands=(
    'bundle check'
    'npm ls --depth=0'
    'npm run pact:validate'
    'npm run pact:lint'
    'bin/rubocop'
    'env RAILS_ENV=test bin/rails db:prepare'
    'env RAILS_ENV=test bin/rails zeitwerk:check'
    'env RAILS_ENV=test bin/rails test'
  )

  for command in "${required_verify_commands[@]}"; do
    if ! printf '%s\n' "$verify_body" | grep -Fq "$command"; then
      printf 'bin/verify is missing required command: %s\n' "$command" >&2
      exit 1
    fi
  done

  # 標準モードは Docker を起動しない。基盤検証は完全モードの責務とする。
  if printf '%s\n' "$verify_body" | grep -Eq '(^|[[:space:]])docker([[:space:]]|$)'; then
    printf 'bin/verify standard mode must not invoke Docker directly\n' >&2
    exit 1
  fi

  # セットアップと検証を混在させない。
  if printf '%s\n' "$verify_body" | grep -Fq 'bin/setup'; then
    printf 'bin/verify must not perform setup\n' >&2
    exit 1
  fi

  # セキュリティ・依存関係検査の必須化は P0-T9 で扱う。
  if printf '%s\n' "$verify_body" | grep -Eq 'bundler-audit|importmap audit|brakeman'; then
    printf 'security audits belong to P0-T9\n' >&2
    exit 1
  fi

  # bin/ci は委譲するだけの互換ラッパーとする。
  #
  # 委譲行の存在確認では、その前後へ独自の検証コマンドを置いた bin/ci を検出できない。
  # コメントと空行を除いた実行行を、完全一致で検査する。
  ruby - <<'RUBY'
    path = "bin/ci"
    lines = File.readlines(path, chomp: true, encoding: "UTF-8")

    shebang = lines.shift

    unless shebang == "#!/usr/bin/env bash"
      warn "bin/ci must use the expected shebang"
      exit 1
    end

    executable_lines = lines.reject do |line|
      line.strip.empty? || line.lstrip.start_with?("#")
    end

    expected_lines = [
      "set -euo pipefail",
      'APP_ROOT="$(',
      '  cd "$(dirname "${BASH_SOURCE[0]}")/.."',
      "  pwd",
      ')"',
      'exec "$APP_ROOT/bin/verify" --full "$@"'
    ]

    unless executable_lines == expected_lines
      warn "bin/ci must only delegate to bin/verify --full"
      warn "expected:"
      expected_lines.each { |line| warn("  #{line}") }
      warn "actual:"
      executable_lines.each { |line| warn("  #{line}") }
      exit 1
    end
RUBY

  # 完全モードをコンテナ内から呼ぶと、この検証自身を無限に呼び戻す。
  docker_verification_body="$(grep -v '^[[:space:]]*#' scripts/verify-p0-docker)"

  if printf '%s\n' "$docker_verification_body" | grep -Fq 'bin/verify --full'; then
    printf 'scripts/verify-p0-docker must not invoke the full mode\n' >&2
    exit 1
  fi
fi

# --- P0-T8: 日本語・英語の i18n 基盤 ------------------------------------------
#
# P0-T8 が開始された時点で有効になる。
# Docker 検証より前へ置き、契約違反を build より先に失敗させる。
# 受け入れ条件の詳細は design/acceptance/P0-T8-i18n-bootstrap.md を参照する。

if task_has_event "P0-T8"; then
  test -f config/locales/ja.yml
  test -f config/locales/en.yml
  test -f test/configuration/i18n_configuration_test.rb

  # 共通の日本語ロケールデータは依存で賄う。同じ gem を複数の行で宣言しない。
  # 宣言が重複すると、後の行のバージョン指定が黙って優先される。
  rails_i18n_declarations="$(
    grep -Ec '^[[:space:]]*gem[[:space:]]+["'\'']rails-i18n["'\'']' Gemfile || true
  )"

  if [[ "$rails_i18n_declarations" -ne 1 ]]; then
    printf \
      'expected exactly one rails-i18n declaration in Gemfile, found %s\n' \
      "$rails_i18n_declarations" \
      >&2
    exit 1
  fi

  # 設定ファイルの記述ではなく、boot 後の I18n の実測値を検査する。
  # Rails は config.i18n の一部のキーを初期化時に取り除くため、
  # 設定オブジェクトを読み返しても実際の挙動は分からない。
  env \
    RAILS_ENV=test \
    DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
    PGCONNECT_TIMEOUT=1 \
    bundle exec rails runner - <<'RUBY'
    expected_locales = %i[ja en].to_set
    actual_locales = I18n.available_locales.map(&:to_sym).to_set

    abort "unexpected available locales: #{actual_locales.to_a.inspect}" \
      unless actual_locales == expected_locales

    abort "unexpected default locale: #{I18n.default_locale.inspect}" \
      unless I18n.default_locale == :ja

    begin
      I18n.with_locale(:fr) { nil }
      abort "unsupported locale was accepted: fr"
    rescue I18n::InvalidLocale
      # 期待どおり拒否された
    end

    fallbacks_enabled = I18n.backend.class.ancestors.any? do |ancestor|
      ancestor.name == "I18n::Backend::Fallbacks"
    end

    abort "i18n fallbacks must be disabled" if fallbacks_enabled

    begin
      I18n.t("verify_p0_missing_translation_probe")
      abort "missing translations must raise in the test environment"
    rescue I18n::MissingTranslationData
      # 期待どおり検出された
    end

    %i[ja en].each do |locale|
      name = I18n.t("application.name", locale: locale)

      abort "unexpected application.name for #{locale}: #{name.inspect}" \
        unless name == "RoleWeave"

      path = Rails.root.join("config/locales/#{locale}.yml")
      dictionary = YAML.safe_load_file(path, aliases: false, permitted_classes: [])

      abort "generated sample translation remains in #{path}" \
        if dictionary.fetch(locale.to_s).key?("hello")
    end
RUBY
fi

# --- P0-T8A: production の i18n フォールバック -------------------------------
#
# P0-T8A が開始された時点で有効になる。
# 受け入れ条件の詳細は design/acceptance/P0-T8A-production-i18n-fallback.md を参照する。
#
# test/configuration/i18n_configuration_test.rb は test 環境で実行されるため、
# production の設定を検証できない。環境設定はアプリケーション共通設定より後に
# 読み込まれ、上書きできる。production は実際に boot して確認する。

if task_has_event "P0-T8A"; then
  # フォールバックの正本は config/application.rb だけとする。
  if grep -Eq \
    '^[[:space:]]*config\.i18n\.fallbacks[[:space:]]*=[[:space:]]*true' \
    config/environments/production.rb
  then
    printf 'production must not enable i18n fallbacks\n' >&2
    exit 1
  fi

  # production は boot 時に SECRET_KEY_BASE を要求する。
  # 検証用の使い捨て値を都度生成し、リポジトリへ秘密情報を持ち込まない。
  secret_key_base="$(
    ruby -rsecurerandom -e 'print SecureRandom.hex(64)'
  )"

  env \
    RAILS_ENV=production \
    SECRET_KEY_BASE="$secret_key_base" \
    DATABASE_URL=postgresql://127.0.0.1:1/roleweave_production \
    PGCONNECT_TIMEOUT=1 \
    bundle exec rails runner - <<'RUBY'
    # 祖先クラス名の確認だけでは、フォールバックの経路が変わったときに追随できない。
    # 日本語だけの翻訳を登録し、英語から解決されない振る舞いそのものを確認する。
    key = :p0_t8a_production_fallback_probe
    I18n.backend.store_translations(:ja, { key => "日本語だけの文言" })

    begin
      I18n.t(key, locale: :en, raise: true)
      abort "production i18n fallback is enabled"
    rescue I18n::MissingTranslationData
      # 期待どおり、英語の欠落を日本語では補わない
    end
RUBY
fi

# --- P0-T8B / P0-T8C / P0-T8D: i18n フォールバックの単一正本 ------------------
#
# P0-T8B が開始された時点で有効になる。
# 受け入れ条件の正本は次の 3 つとする。
#
#   design/acceptance/P0-T8B-i18n-and-code-pact-contract.md
#   design/acceptance/P0-T8C-i18n-assignment-parser.md
#   design/acceptance/P0-T8D-i18n-assignment-coverage.md
#
# P0-T8A の production 検査と役割が異なる。
# boot 検査は「実際にフォールバックしないこと」を、この検査は
# 「設定の正本が 1 か所だけであること」を保証する。どちらも削除しない。
#
# 重複した false や別環境での再定義は、現在の挙動を変えないため
# boot 検査では検出できない。しかし正本が 2 つになった時点で、
# 次に片方だけ変更されたときの矛盾が生まれる。
#
# 検査の変遷。
#
#   P0-T8B  Ripper.lex のトークン列で `config . i18n . fallbacks =` を探した。
#           演算子を = へ完全一致させていたため ||= と &&= を検出できなかった。
#   P0-T8C  Ripper.sexp の :assign / :opassign 検査へ置き換えた。
#           多重代入と括弧付き receiver を検出できなかった。
#   P0-T8D  :massign と receiver の括弧正規化を追加し、
#           分類できない fallbacks 参照を fail-closed で拒否する。

if task_has_event "P0-T8B"; then
  ruby - <<'RUBY'
    require "ripper"

    # 環境設定はアプリケーション共通設定より後に読み込まれ、上書きできる。
    # 上書きが起こりうる範囲だけを対象にする。
    target_files = [
      "config/application.rb",
      "config/environments/development.rb",
      "config/environments/test.rb",
      "config/environments/production.rb"
    ]

    # 単一式を包む括弧を再帰的に剥がす。
    # 括弧は意味を変えないため、receiver と値の双方で正規化する。
    # 値だけを正規化すると (config.i18n).fallbacks = true を見逃す。
    unwrap_paren = lambda do |node|
      current = node

      loop do
        break unless current.is_a?(Array) && current[0] == :paren

        body = current[1]
        break unless body.is_a?(Array) && body.length == 1

        current = body[0]
      end

      current
    end

    # 呼び出しチェーンの末尾にある識別子名を返す。
    # config が method call でも local variable でも同じ名前を取り出す。
    trailing_name = lambda do |node|
      node = unwrap_paren.call(node)

      next nil unless node.is_a?(Array)

      token =
        case node[0]
        when :vcall, :var_ref then node[1]
        when :call then node[3]
        end

      next nil unless token.is_a?(Array) && token[0] == :@ident

      token[1]
    end

    # 代入 target が config.i18n.fallbacks へ到達する field かどうかを判定し、
    # 該当するなら識別子の位置を返す。
    #
    # receiver の前に何があっても、末尾 3 つが config / i18n / fallbacks なら対象とする。
    # Rails.application.config.i18n.fallbacks = ... も同じ設定を書き換える。
    fallbacks_field_position = lambda do |target|
      target = unwrap_paren.call(target)

      next nil unless target.is_a?(Array) && target[0] == :field

      name_token = target[3]

      next nil unless name_token.is_a?(Array) && name_token[0] == :@ident
      next nil unless name_token[1] == "fallbacks"

      receiver = unwrap_paren.call(target[1])

      next nil unless trailing_name.call(receiver) == "i18n"
      next nil unless receiver.is_a?(Array) && receiver[0] == :call
      next nil unless trailing_name.call(receiver[1]) == "config"

      name_token[2]
    end

    # boolean literal だけを値として認める。
    # 動的な式、メソッド呼び出し、数値、文字列はここで nil になる。
    boolean_literal = lambda do |node|
      node = unwrap_paren.call(node)

      next nil unless node.is_a?(Array) && node[0] == :var_ref

      token = node[1]
      next nil unless token.is_a?(Array) && token[0] == :@kw

      case token[1]
      when "true" then true
      when "false" then false
      end
    end

    # 多重代入の左辺を再帰的に走査し、対象 field をすべて集める。
    # 左辺のどこに現れても同じ設定を書き換える。
    collect_fallback_fields = lambda do |node, found|
      next found unless node.is_a?(Array)

      position = fallbacks_field_position.call(node)
      found << position if position

      node.each do |child|
        collect_fallback_fields.call(child, found) if child.is_a?(Array)
      end

      found
    end

    # 構文木を再帰的に走査し、assign / opassign / massign を集める。
    collect_assignments = lambda do |node, found|
      next found unless node.is_a?(Array)

      case node[0]
      when :assign, :opassign
        position = fallbacks_field_position.call(node[1])

        if position
          operator = node[0] == :assign ? "=" : node[2][1]
          value_node = node[0] == :assign ? node[2] : node[3]
          literal = boolean_literal.call(value_node)

          found << {
            position: position,
            operator: operator,
            value: literal.nil? ? "(non-boolean)" : literal.to_s
          }
        end
      when :massign
        # 右辺と左辺を対応付けて許可判定しない。多重代入構文そのものを禁止する。
        # 設定の正本は 1 行の plain assignment へ固定すればよく、
        # 左右の対応を解析する複雑さを検証器へ持ち込まない。
        collect_fallback_fields.call(node[1], []).each do |position|
          found << {
            position: position,
            operator: "massign",
            value: "(multiple-assignment)"
          }
        end
      end

      node.each { |child| collect_assignments.call(child, found) if child.is_a?(Array) }

      found
    end

    # コード上に現れる fallbacks 識別子の位置を集める。
    # コメントと文字列リテラルはトークン種別が異なるため、ここには入らない。
    fallbacks_identifiers = lambda do |source|
      Ripper.lex(source).filter_map do |(position, type, token, _state)|
        next unless type == :on_ident
        next unless token == "fallbacks" || token == "fallbacks="

        [ position, token ]
      end
    end

    parse = lambda do |source, label|
      sexp = Ripper.sexp(source)

      # 解析できないファイルを「代入 0 件」として扱わない。
      if sexp.nil?
        warn "failed to parse as Ruby: #{label}"
        exit 1
      end

      assignments = collect_assignments.call(sexp, [])
      classified = assignments.map { |assignment| assignment[:position] }

      unclassified = fallbacks_identifiers.call(source).reject do |(position, _token)|
        classified.include?(position)
      end

      [ assignments, unclassified ]
    end

    # 対象ソース群を検査し、失敗理由の一覧を返す。
    #
    # 実ファイルの検査と検証器自身の検査を同じ経路へ通す。
    # 判定を実ファイル側にだけ書くと、判定そのものを外した退行を自己検査で拾えない。
    inspect_sources = lambda do |sources|
      assignments = []
      unclassified_references = []

      sources.each do |(label, source)|
        found, unclassified = parse.call(source, label)

        assignments.concat(found.map { |assignment| assignment.merge(path: label) })
        unclassified_references.concat(
          unclassified.map { |(position, token)| { path: label, position: position, token: token } }
        )
      end

      failures = []

      unless unclassified_references.empty?
        failures << "unclassified i18n fallback reference"

        unclassified_references.each do |reference|
          line, column = reference[:position]
          failures << "  #{reference[:path]}:#{line}:#{column} token=#{reference[:token]}"
        end
      end

      expected = { path: "config/application.rb", operator: "=", value: "false" }

      valid =
        assignments.length == 1 &&
        assignments.first[:path] == expected[:path] &&
        assignments.first[:operator] == expected[:operator] &&
        assignments.first[:value] == expected[:value]

      unless valid
        failures << "expected exactly one i18n fallback assignment"
        failures << "  #{expected[:path]}: config.i18n.fallbacks #{expected[:operator]} #{expected[:value]}"
        failures << "actual:"

        if assignments.empty?
          failures << "  (none)"
        else
          assignments.each do |assignment|
            failures << (
              "  #{assignment[:path]}:#{assignment[:position].first} " \
              "operator=#{assignment[:operator]} value=#{assignment[:value]}"
            )
          end
        end
      end

      failures
    end

    # --- 検証器自身の検査 -----------------------------------------------------
    #
    # P0-T8B の検出漏れは、検証器を検証する仕組みがなかったために見逃された。
    # P0-T8C でも構文の網羅性までは確認できていなかった。
    # 同じ退行が起きたら、通常の bin/verify で気づけるようにする。

    detected_probes = [
      [ "config.i18n.fallbacks = false", "=", "false" ],
      [ "config.i18n.fallbacks ||= true", "||=", "true" ],
      [ "config.i18n.fallbacks &&= false", "&&=", "false" ],
      [ "config.i18n.fallbacks += 1", "+=", "(non-boolean)" ],
      [ "Rails.application.config.i18n.fallbacks = true", "=", "true" ],
      [ "config.i18n.fallbacks = (false)", "=", "false" ],
      [ "config.i18n.fallbacks = dynamic_value", "=", "(non-boolean)" ],
      [ "(config.i18n).fallbacks = true", "=", "true" ],
      [ "((config.i18n)).fallbacks = true", "=", "true" ],
      [ "(Rails.application.config.i18n).fallbacks = true", "=", "true" ],
      [ "(config).i18n.fallbacks = true", "=", "true" ],
      [ "config.i18n.fallbacks, other = true, nil", "massign", "(multiple-assignment)" ],
      [ "other, config.i18n.fallbacks = nil, true", "massign", "(multiple-assignment)" ],
      [ "config.i18n.fallbacks, = true", "massign", "(multiple-assignment)" ]
    ]

    detected_probes.each do |(source, operator, value)|
      assignments, unclassified = parse.call(source, "self-test: #{source}")

      unless assignments.length == 1 &&
             assignments.first[:operator] == operator &&
             assignments.first[:value] == value &&
             unclassified.empty?
        warn "scanner self-test failed: #{source}"
        warn "  expected: operator=#{operator} value=#{value} unclassified=0"
        warn "  actual:   #{assignments.inspect} unclassified=#{unclassified.inspect}"
        exit 1
      end
    end

    # 構文木で分類できない記述は、通すのではなく止める。
    # 正しい設定方法としてサポートする必要はない。検証不能として拒否する。
    unclassified_probes = [
      "config.i18n.public_send(:fallbacks=, true)",
      "config.i18n.send(:fallbacks=, true)",
      "i18n_config = config.i18n\ni18n_config.fallbacks = true"
    ]

    unclassified_probes.each do |source|
      _assignments, unclassified = parse.call(source, "self-test: #{source}")

      if unclassified.empty?
        warn "scanner self-test failed: #{source} must be rejected as unclassified"
        exit 1
      end
    end

    ignored_probes = [
      "# config.i18n.fallbacks = true",
      'message = "config.i18n.fallbacks = true"',
      "config.i18n.other = false"
    ]

    ignored_probes.each do |source|
      assignments, unclassified = parse.call(source, "self-test: #{source}")

      unless assignments.empty? && unclassified.empty?
        warn "scanner self-test failed: #{source} must not be detected"
        warn "  actual: #{assignments.inspect} unclassified=#{unclassified.inspect}"
        exit 1
      end
    end

    # 判定そのものを外した退行を拾うため、実ファイルと同じ inspect_sources を通す。
    canonical_source = [ [ "config/application.rb", "config.i18n.fallbacks = false" ] ]

    unless inspect_sources.call(canonical_source).empty?
      warn "scanner self-test failed: the canonical assignment must pass"
      warn "  actual: #{inspect_sources.call(canonical_source).inspect}"
      exit 1
    end

    rejected_sources = [
      [ "unclassified", "config.i18n.public_send(:fallbacks=, true)" ],
      [ "massign", "config.i18n.fallbacks, other = true, nil" ],
      [ "parenthesised receiver", "(config.i18n).fallbacks = true" ]
    ]

    rejected_sources.each do |(label, source)|
      sources = canonical_source + [ [ "config/environments/development.rb", source ] ]

      if inspect_sources.call(sources).empty?
        warn "scanner self-test failed: #{label} must be rejected by inspect_sources"
        warn "  source: #{source}"
        exit 1
      end
    end

    # --- 実ファイルの検査 -----------------------------------------------------

    failures = inspect_sources.call(
      target_files.map { |path| [ path, File.read(path, encoding: "UTF-8") ] }
    )

    unless failures.empty?
      failures.each { |line| warn line }
      exit 1
    end
RUBY
fi

# --- P0-T4: Docker Compose と PostgreSQL -------------------------------------
#
# P0-T4 が開始された時点で有効になる。
# Docker daemon への接続とコンテナの起動を伴うため、検証本体は別スクリプトへ分ける。
# 受け入れ条件の詳細は design/acceptance/P0-T4-docker-compose.md を参照する。

if task_has_event "P0-T4"; then
  scripts/verify-p0-docker
fi
