#!/usr/bin/env bash
# P0 Project Foundation の検証。
#
# 過去タスクの実行履歴ではなく、現在の Foundation 契約を検証する。
# 検証はイベントや進捗台帳の有無に依存せず、常にすべて実行する。
#
# このスクリプトは bin/verify --full から呼ばれる内部実装とする。
# 利用者と CI が直接実行する入口にはしない。
set -euo pipefail

# 必須の行がちょうど 1 件だけ存在することを確認する。
# 欠落と重複の両方を失敗として扱う。
# 単純な存在確認では、既存設定を置換した不完全なファイルや、
# 同じ行を繰り返し追記したファイルを検出できない。
require_exact_line_once() {
  local expected="$1"
  local file="$2"
  local count

  if [[ ! -f "$file" ]]; then
    printf 'required file is missing: %s\n' "$file" >&2
    return 1
  fi

  count="$(
    awk -v expected="$expected" '
      $0 == expected { count += 1 }
      END { print count + 0 }
    ' "$file"
  )"

  if [[ "$count" -ne 1 ]]; then
    printf \
      'expected exactly one line in %s, found %s: %s\n' \
      "$file" \
      "$count" \
      "$expected" \
      >&2
    return 1
  fi
}

# 必須ファイルの欠落を、対象 path 付きで失敗させる。
# 裸の test -f は診断を出さないため、CI ではどの正本が欠けたのか分からない。
require_file() {
  local path="$1"

  if [[ ! -f "$path" ]]; then
    printf 'required file is missing: %s\n' "$path" >&2
    return 1
  fi
}

# パターンが現れないことを、診断付きで検査する。
#
# `! grep ...` とは書かない。Bash は `!` 予約語で始まるパイプラインへ errexit を
# 適用しないため、一致しても次の行へ進み、検査が常に成功してしまう。
#
#   bash -c 'set -e; ! true; echo reached'
#   => reached
#
# 一致した行を診断へ出す。どの行が契約へ触れたのかが分からないと、直せない。
refute_pattern() {
  local matcher="$1"
  local pattern="$2"
  local file="$3"

  if [[ ! -f "$file" ]]; then
    printf 'required file is missing: %s\n' "$file" >&2
    return 1
  fi

  if grep -n "$matcher" -e "$pattern" -- "$file" >&2; then
    printf '%s must not contain: %s\n' "$file" "$pattern" >&2
    return 1
  fi
}

# --- 撤去済みの開発依存を持ち込まない ------------------------------------------
#
# code-pact と Node.js は P0-R1 で撤去した。
# 進捗・契約の正本は GitHub Issues と Pull Requests であり、
# ツール固有の制御面やイベント台帳を再導入しない。

test ! -e .code-pact
test ! -e .node-version
test ! -e package.json
test ! -e package-lock.json
test ! -e docs/development/code-pact.md

# --- 否定形の裸の検査を書き戻さない -------------------------------------------
#
# Bash は `!` 予約語で始まるパイプラインへ errexit を適用しない。
# 行頭が `!` の検査は、違反しても次の行へ進むため、常に成功する。
# 診断も出ないため、検査が効いていないことに気付けない。
#
# 検査を足すときは refute_pattern（または対象ごとの同種の関数）を使う。
# `if ! foo; then` のように条件として使う形は、行頭が `!` にならないため対象外とする。

negation_checked_scripts=(
  bin/verify
  bin/ci
  scripts/verify-p0
  scripts/verify-p0-docker
)

for script in "${negation_checked_scripts[@]}"; do
  if grep -nE '^[[:space:]]*![[:space:]]*[a-z]' "$script"; then
    printf '%s must not use a bare negated command as a check\n' "$script" >&2
    exit 1
  fi
done

# --- プロジェクト文書の正本 -----------------------------------------------------
#
# 文書の正本は docs/ へ集約する。
# code-pact 時代の配置を引き継いだ design/ は P0-R2 で撤去した。

require_file docs/principles.md
require_file docs/development/language-policy.md
require_file docs/development/workflow.md

# 実行タスクの入口である Issue テンプレートも P0 の必須成果物とする。
require_file .github/ISSUE_TEMPLATE/bug.yml
require_file .github/ISSUE_TEMPLATE/implementation.yml

ruby -ryaml -e '
  %w[
    .github/ISSUE_TEMPLATE/bug.yml
    .github/ISSUE_TEMPLATE/implementation.yml
  ].each do |path|
    document = YAML.load_file(path)
    abort "#{path} must be a mapping" unless document.is_a?(Hash)
  end
'

# 文書の正本を docs/ へ集約した状態を維持する。
# 過去の設計文書と受け入れ計画は Git 履歴と PR で参照する。
#
# 検査は 2 つに分ける。
#
#   ディレクトリ  design 配下へ追跡ファイルを置き直すことを拒否する
#   参照         削除済みの具体的な文書 path を正本として書き戻すことを拒否する
#
# 参照検査は「design/ という文字列」を禁止しない。
# 一般的な英単語、外部 URL、無関係な語句まで拒否すると、
# 検査の目的（旧 path の再参照防止）から外れた失敗を生む。
if git ls-files -- design | grep -q .; then
  printf 'design/ must not contain tracked files\n' >&2
  git ls-files -- design >&2
  exit 1
fi

# 撤去済みの正本 path。ディレクトリは末尾のスラッシュまで含めて照合する。
removed_design_references=(
  "design/brief.md"
  "design/constitution.md"
  "design/roadmap.yaml"
  "design/phases/"
  "design/rules/"
  "design/decisions/"
  "design/acceptance/"
)

# 探索対象を固定した一覧にすると、bin や他の検証器、ルート設定ファイルへ
# 参照を書き戻したときに検出できない。追跡ファイル全体を対象にする。
#
# 追跡ファイルに限るのは、リポジトリの内容だけを契約とするためである。
# 作業ツリー全体を走査すると、gitignore 済みのローカル作業ファイルによって
# 手元だけが失敗し、新規 clone と CI では成功する検証になる。
#
# 検査文字列そのものを含むこのスクリプトは対象から除く。
# grep へ /dev/null を併せて渡し、単一ファイルでも診断へパスを含める。
removed_design_reference_found=0

while IFS= read -r -d '' path; do
  [[ "$path" == "scripts/verify-p0" ]] && continue
  [[ -f "$path" ]] || continue

  for removed_reference in "${removed_design_references[@]}"; do
    if grep -InI -F "$removed_reference" "$path" /dev/null; then
      removed_design_reference_found=1
    fi
  done
done < <(git ls-files -z)

if [[ "$removed_design_reference_found" -ne 0 ]]; then
  printf 'removed design document paths must not be referenced\n' >&2
  exit 1
fi

# --- 撤去済みのローカル制御面 ---------------------------------------------------
#
# .context と .local は code-pact 時代のローカルディレクトリ契約であり、P0-R2 で撤去した。
# ignore 対象から外すことで、再生成された場合に git status で可視化される。
#
# 作業ツリー上の存在そのものは契約にしない。
# Git 管理外のローカル状態は新規 clone と CI には存在せず、
# リポジトリの契約は ignore 設定と追跡ファイルで保証できる。

removed_local_control_ignores=(
  "/.context/"
  "/.local/"
)

for line in "${removed_local_control_ignores[@]}"; do
  if grep -Fxq "$line" .gitignore; then
    printf '.gitignore must not ignore %s\n' "$line" >&2
    exit 1
  fi
done

# --- P0 全体で持ち込まない生成物 ---------------------------------------------
#
# デプロイ基盤（Kamal）、Thruster、開発用コンテナは採用していない。
# Rails が一時生成する master key と、それで暗号化された credentials も持ち込まない。

test ! -e .kamal
test ! -e config/deploy.yml
test ! -e bin/kamal
test ! -e bin/thrust
test ! -e .devcontainer
test ! -e config/master.key
test ! -e config/credentials.yml.enc

# --- GitHub Actions による統一検証 -------------------------------------------
#
# Workflow 構造検査は Docker build より前へ置き、契約違反を build より先に失敗させる。

test -d .github/workflows
test -f .github/workflows/ci.yml
test -x scripts/verify-github-actions
test -x scripts/verify-github-actions-self-test

# Dependabot は P0-T9 の非目標であり、P0 では持ち込まない。
test ! -e .github/dependabot.yml

# P0 では Workflow を ci.yml の 1 つに限定する。
# 検証入口が増えると、bin/verify を正本とする委譲経路が成立しなくなる。
workflow_count="$(
  find .github/workflows -maxdepth 1 -type f | wc -l | tr -d ' '
)"
test "$workflow_count" = "1"

scripts/verify-github-actions

# 構造検査は「契約違反を拒否できること」まで含めて初めて意味を持つ。
# 負の検証を実行時の手作業に依存させると、検証器の退行に気づけない。
scripts/verify-github-actions-self-test

# --- Rails アプリケーションの実体 -------------------------------------------

test -f Gemfile
test -f Gemfile.lock
test -f Rakefile
test -f config.ru
test -x bin/rails
test -f config/application.rb
test -f config/database.yml
test -d app
test -d test

# 固定バージョン。ファイルの内容だけでなく実行中のランタイムを検査する。
test -f .ruby-version
test "$(tr -d '\r\n' < .ruby-version)" = "4.0.6"
test "$(ruby -e 'print RUBY_VERSION')" = "4.0.6"
test "$(bundle exec rails --version)" = "Rails 8.1.3.1"

test -f .gitignore
test -f .gitattributes
test -f .rubocop.yml

# Rails 8.1.3 標準の除外設定。
# .keep の除外解除がないと、維持すると宣言した .keep が Git 管理対象にならない。
rails_gitignore_lines=(
  "/.bundle"
  "/.env*"
  "/log/*"
  "!/log/.keep"
  "/tmp/*"
  "!/tmp/.keep"
  "/tmp/pids/*"
  "!/tmp/pids/"
  "!/tmp/pids/.keep"
  "/storage/*"
  "!/storage/.keep"
  "/tmp/storage/*"
  "!/tmp/storage/"
  "!/tmp/storage/.keep"
  "/public/assets"
  "/config/*.key"
)

for line in "${rails_gitignore_lines[@]}"; do
  require_exact_line_once "$line" .gitignore
done

require_exact_line_once "db/schema.rb linguist-generated" .gitattributes
require_exact_line_once "vendor/* linguist-vendored" .gitattributes

grep -Eq 'gem[[:space:]]+["'\'']pg["'\'']' Gemfile
grep -Eq 'adapter:[[:space:]]*postgresql' config/database.yml
grep -Eq 'module[[:space:]]+RoleWeave' config/application.rb

bundle check

# PostgreSQL サーバーがない状態で boot できることを確認する。
# 接続不能な DATABASE_URL を与え、boot 中に不用意な DB 接続が起きていないことを検出する。
env \
  RAILS_ENV=test \
  DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
  PGCONNECT_TIMEOUT=1 \
  bundle exec rails zeitwerk:check

env \
  RAILS_ENV=test \
  DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
  PGCONNECT_TIMEOUT=1 \
  bundle exec rails runner \
  'abort "unexpected application namespace" unless Rails.application.class.module_parent_name == "RoleWeave"'

# README が事実誤認を残していないこと
refute_pattern -F 'アプリケーションは実装されていません' README.md
refute_pattern -F 'application itself has not been implemented' README.en.md

# --- 統一検証コマンド --------------------------------------------------------
#
# Docker 検証は build とコンテナ起動を伴うため、契約違反はその前に失敗させる。

test -x bin/verify
test -x bin/ci

# 検証定義の二重正本を残さない。
test ! -e config/ci.rb

bash -n bin/verify
bash -n bin/ci

# コメント行は検査対象から外す。
# 正規コマンドを説明するヘッダーコメントと、実際に実行するコマンドを混同しない。
verify_body="$(grep -v '^[[:space:]]*#' bin/verify)"

required_verify_commands=(
  'bundle check'
  'bin/rubocop'
  'env RAILS_ENV=test bin/rails db:prepare'
  'env RAILS_ENV=test bin/rails zeitwerk:check'
  'env RAILS_ENV=test bin/rails test'
)

for command in "${required_verify_commands[@]}"; do
  if ! printf '%s\n' "$verify_body" | grep -Fq "$command"; then
    printf 'bin/verify is missing required command: %s\n' "$command" >&2
    exit 1
  fi
done

# 標準モードは Docker を起動しない。基盤検証は完全モードの責務とする。
if printf '%s\n' "$verify_body" | grep -Eq '(^|[[:space:]])docker([[:space:]]|$)'; then
  printf 'bin/verify standard mode must not invoke Docker directly\n' >&2
  exit 1
fi

# セットアップと検証を混在させない。
if printf '%s\n' "$verify_body" | grep -Fq 'bin/setup'; then
  printf 'bin/verify must not perform setup\n' >&2
  exit 1
fi

# セキュリティ検査の構造は専用の検証器が持つ。
#
# 検査の実体は bin/verify が Brakeman と bundler-audit を実行して行う。
# ここで確認するのは、その呼び出しが削除・無効化・任意化されていないことである。
#
# 検査内容をこのスクリプトへ直接書くと、負の検証が同じ判定を複製することになる。
# 一時作業ツリーを引数で受け取れる検証器へ分け、正本を 1 つに保つ。
test -x scripts/verify-security
test -x scripts/verify-security-self-test

scripts/verify-security

# 構造検査は「契約違反を拒否できること」まで含めて初めて意味を持つ。
# 負の検証を実行時の手作業に依存させると、検証器の退行に気づけない。
scripts/verify-security-self-test

# bin/ci は委譲するだけの互換ラッパーとする。
#
# 委譲行の存在確認では、その前後へ独自の検証コマンドを置いた bin/ci を検出できない。
# コメントと空行を除いた実行行を、完全一致で検査する。
ruby - <<'RUBY'
  path = "bin/ci"
  lines = File.readlines(path, chomp: true, encoding: "UTF-8")

  shebang = lines.shift

  unless shebang == "#!/usr/bin/env bash"
    warn "bin/ci must use the expected shebang"
    exit 1
  end

  executable_lines = lines.reject do |line|
    line.strip.empty? || line.lstrip.start_with?("#")
  end

  expected_lines = [
    "set -euo pipefail",
    'APP_ROOT="$(',
    '  cd "$(dirname "${BASH_SOURCE[0]}")/.."',
    "  pwd",
    ')"',
    'exec "$APP_ROOT/bin/verify" --full "$@"'
  ]

  unless executable_lines == expected_lines
    warn "bin/ci must only delegate to bin/verify --full"
    warn "expected:"
    expected_lines.each { |line| warn("  #{line}") }
    warn "actual:"
    executable_lines.each { |line| warn("  #{line}") }
    exit 1
  end
RUBY

# 完全モードをコンテナ内から呼ぶと、この検証自身を無限に呼び戻す。
docker_verification_body="$(grep -v '^[[:space:]]*#' scripts/verify-p0-docker)"

if printf '%s\n' "$docker_verification_body" | grep -Fq 'bin/verify --full'; then
  printf 'scripts/verify-p0-docker must not invoke the full mode\n' >&2
  exit 1
fi

# --- 日本語・英語の i18n 基盤 ------------------------------------------------

test -f config/locales/ja.yml
test -f config/locales/en.yml
test -f test/configuration/i18n_configuration_test.rb

# 共通の日本語ロケールデータは依存で賄う。同じ gem を複数の行で宣言しない。
# 宣言が重複すると、後の行のバージョン指定が黙って優先される。
rails_i18n_declarations="$(
  grep -Ec '^[[:space:]]*gem[[:space:]]+["'\'']rails-i18n["'\'']' Gemfile || true
)"

if [[ "$rails_i18n_declarations" -ne 1 ]]; then
  printf \
    'expected exactly one rails-i18n declaration in Gemfile, found %s\n' \
    "$rails_i18n_declarations" \
    >&2
  exit 1
fi

# 設定ファイルの記述ではなく、boot 後の I18n の実測値を検査する。
# Rails は config.i18n の一部のキーを初期化時に取り除くため、
# 設定オブジェクトを読み返しても実際の挙動は分からない。
env \
  RAILS_ENV=test \
  DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
  PGCONNECT_TIMEOUT=1 \
  bundle exec rails runner - <<'RUBY'
  expected_locales = %i[ja en].to_set
  actual_locales = I18n.available_locales.map(&:to_sym).to_set

  abort "unexpected available locales: #{actual_locales.to_a.inspect}" \
    unless actual_locales == expected_locales

  abort "unexpected default locale: #{I18n.default_locale.inspect}" \
    unless I18n.default_locale == :ja

  begin
    I18n.with_locale(:fr) { nil }
    abort "unsupported locale was accepted: fr"
  rescue I18n::InvalidLocale
    # 期待どおり拒否された
  end

  fallbacks_enabled = I18n.backend.class.ancestors.any? do |ancestor|
    ancestor.name == "I18n::Backend::Fallbacks"
  end

  abort "i18n fallbacks must be disabled" if fallbacks_enabled

  begin
    I18n.t("verify_p0_missing_translation_probe")
    abort "missing translations must raise in the test environment"
  rescue I18n::MissingTranslationData
    # 期待どおり検出された
  end

  %i[ja en].each do |locale|
    name = I18n.t("application.name", locale: locale)

    abort "unexpected application.name for #{locale}: #{name.inspect}" \
      unless name == "RoleWeave"

    path = Rails.root.join("config/locales/#{locale}.yml")
    dictionary = YAML.safe_load_file(path, aliases: false, permitted_classes: [])

    abort "generated sample translation remains in #{path}" \
      if dictionary.fetch(locale.to_s).key?("hello")
  end
RUBY

# --- i18n フォールバックの単一正本と実動作 -------------------------------------
#
# 検証は 2 段構えとする。
#
#   ソース規約  config 配下に fallbacks を含むコードを 1 行だけ許可する保守規約
#   実動作検査  development / test / production を独立プロセスで boot し、
#               英語の欠落が日本語へ解決されないことを確認する
#
# ソース規約は Ruby の意味解析ではない。動的な文字列結合など、
# トークン検査を回避できるコードは存在し得る。その保証は実動作検査が担う。
# config.i18n は ActiveSupport::OrderedOptions であり Hash を継承するため、
# 代入構文を列挙する方式では設定変更経路を網羅できない。

# --- ソース規約 -----------------------------------------------------------------
#
# Rails の I18n 初期化はアプリケーション initializer より後に実行される。
# environments だけでなく initializers からも上書きできるため、
# config 配下の Ruby ファイルすべてを対象にする。

ruby - <<'RUBY'
  require "ripper"

  CANONICAL_PATH = "config/application.rb"
  CANONICAL_LINE = "config.i18n.fallbacks = false"

  # コメントと埋め込みドキュメントは規約の対象外とする。
  # それ以外のトークンは、文字列・symbol・label・識別子をすべて対象にする。
  # 意味を判定せず、fallbacks という語そのものを禁止する。
  IGNORED_TOKEN_TYPES = %i[
    on_comment
    on_embdoc_beg
    on_embdoc
    on_embdoc_end
  ].freeze

  # 与えられたソース群から fallbacks を含むトークンを集め、失敗理由を返す。
  # 実ファイルと自己検査を同じ経路へ通す。
  inspect_sources = lambda do |sources|
    references = []

    sources.each do |(path, source)|
      if Ripper.sexp(source).nil?
        next references << { path: path, line: 0, text: "(failed to parse as Ruby)" }
      end

      Ripper.lex(source).each do |(position, type, token, _state)|
        next if IGNORED_TOKEN_TYPES.include?(type)
        next unless token.to_s.include?("fallbacks")

        line = position.first

        references << {
          path: path,
          line: line,
          text: source.lines[line - 1].to_s.strip,
          type: type,
          token: token.to_s
        }
      end
    end

    # canonical はソース行の一致だけでは判定できない。
    # ヒアドキュメントの内容トークンでは、その内容行そのものが返るため、
    # 実際の設定代入がなくても canonical 行と一致してしまう。
    # トークンがコード上の識別子であることまで確認する。
    canonical_reference = references.first

    canonical =
      references.length == 1 &&
      canonical_reference[:path] == CANONICAL_PATH &&
      canonical_reference[:text] == CANONICAL_LINE &&
      canonical_reference[:type] == :on_ident &&
      canonical_reference[:token] == "fallbacks"

    next [] if canonical

    failures = ["expected exactly one i18n fallback reference in config/**/*.rb"]
    failures << "  #{CANONICAL_PATH}: #{CANONICAL_LINE}"
    failures << "actual:"

    if references.empty?
      failures << "  (none)"
    else
      references.each do |reference|
        # 構文解析に失敗した参照には :type と :token がない。
        # 診断の表示自体が NoMethodError で落ちると、本来の失敗理由が読めなくなる。
        type = reference[:type] || "(none)"
        token = reference[:token]
        token_text = token ? token.strip : "(none)"

        failures << "  #{reference[:path]}:#{reference[:line]}:"
        failures << "    text=#{reference[:text]}"
        failures << "    type=#{type} token=#{token_text}"
      end
    end

    failures
  end

  # --- 検証器自身の検査 -----------------------------------------------------

  canonical_source = [ [ CANONICAL_PATH, "#{CANONICAL_LINE}\n" ] ]

  accepted_probes = [
    [ "canonical", "#{CANONICAL_LINE}\n" ],
    [ "indented canonical", "    #{CANONICAL_LINE}\n" ],
    [ "comment", "# config.i18n.fallbacks = true\n#{CANONICAL_LINE}\n" ]
  ]

  accepted_probes.each do |(label, source)|
    failures = inspect_sources.call([ [ CANONICAL_PATH, source ] ])

    unless failures.empty?
      warn "source policy self-test failed: #{label} must be accepted"
      failures.each { |line| warn "  #{line}" }
      exit 1
    end
  end

  rejected_probes = [
    [ "string index", 'config.i18n["fallbacks"] = true' ],
    [ "symbol index", "config.i18n[:fallbacks] = true" ],
    [ "merge!", "config.i18n.merge!(fallbacks: true)" ],
    [ "symbol setter", 'config.i18n.public_send(:"fallbacks=", true)' ],
    [ "plain true", "config.i18n.fallbacks = true" ],
    [ "unrelated setting", "config.other.fallbacks = false" ]
  ]

  rejected_probes.each do |(label, source)|
    sources = canonical_source + [ [ "config/environments/development.rb", "#{source}\n" ] ]

    if inspect_sources.call(sources).empty?
      warn "source policy self-test failed: #{label} must be rejected"
      warn "  source: #{source}"
      exit 1
    end
  end

  # canonical 行と同じ文字列を、実際の設定ではない位置へ置いた場合も拒否する。
  # 行の一致だけを見ると、実際の設定代入がなくても通過する。
  canonical_lookalikes = [
    [ "heredoc canonical text", "ignored = <<~TEXT\n#{CANONICAL_LINE}\nTEXT\n" ],
    [ "string canonical text", %(message = "#{CANONICAL_LINE}"\n) ]
  ]

  canonical_lookalikes.each do |(label, source)|
    if inspect_sources.call([ [ CANONICAL_PATH, source ] ]).empty?
      warn "source policy self-test failed: #{label} must be rejected"
      warn "  source: #{source.inspect}"
      exit 1
    end
  end

  # 構文解析に失敗したソースは、例外で落とさずに安全な診断付きで拒否する。
  broken_sources = canonical_source +
    [ [ "config/environments/development.rb", "class Broken\n" ] ]

  broken_failures = inspect_sources.call(broken_sources)

  if broken_failures.empty?
    warn "source policy self-test failed: unparsable Ruby must be rejected"
    exit 1
  end

  unless broken_failures.any? { |line| line.include?("(failed to parse as Ruby)") }
    warn "source policy self-test failed: unparsable Ruby must be reported as a parse failure"
    broken_failures.each { |line| warn "  #{line}" }
    exit 1
  end

  unless broken_failures.any? { |line| line.include?("type=(none) token=(none)") }
    warn "source policy self-test failed: a parse failure must render safe placeholders"
    broken_failures.each { |line| warn "  #{line}" }
    exit 1
  end

  # --- 実ファイルの検査 -----------------------------------------------------

  failures = inspect_sources.call(
    Dir.glob("config/**/*.rb").sort.map { |path| [ path, File.read(path, encoding: "UTF-8") ] }
  )

  unless failures.empty?
    failures.each { |line| warn line }
    exit 1
  end
RUBY

# --- 実動作検査 -----------------------------------------------------------------
#
# ソース規約は静的なトークン検査であり、Ruby のメタプログラミングを証明しない。
# 有効な動作保証はここが担う。
#
# I18n Railtie は初期化状態をプロセス内で保持するため、環境ごとに別プロセスで実行する。
# production は boot 時に SECRET_KEY_BASE を要求するので、
# 使い捨ての値を都度生成し、リポジトリへ秘密情報を持ち込まない。
# 到達不能な DATABASE_URL を与え、boot 中の不用意な DB 接続も併せて検出する。

verify_i18n_fallback_disabled() {
  local environment_name="$1"
  local secret_key_base

  secret_key_base="$(
    ruby -rsecurerandom -e 'print SecureRandom.hex(64)'
  )"

  env \
    RAILS_ENV="$environment_name" \
    SECRET_KEY_BASE="$secret_key_base" \
    DATABASE_URL="postgresql://127.0.0.1:1/roleweave_${environment_name}" \
    PGCONNECT_TIMEOUT=1 \
    bundle exec rails runner - <<'RUBY'
    # 祖先クラス名の確認だけでは、フォールバックの経路が変わったときに追随できない。
    # 日本語だけの翻訳を登録し、英語から解決されない振る舞いそのものを確認する。
    key = :p0_i18n_fallback_probe
    I18n.backend.store_translations(:ja, { key => "日本語だけの文言" })

    begin
      I18n.t(key, locale: :en, raise: true)
      abort "#{Rails.env} i18n fallback is enabled"
    rescue I18n::MissingTranslationData
      # 期待どおり、英語の欠落を日本語では補わない
    end
RUBY
}

verify_i18n_fallback_disabled development
verify_i18n_fallback_disabled test
verify_i18n_fallback_disabled production

# --- Docker Compose と PostgreSQL ---------------------------------------------
#
# Docker daemon への接続とコンテナの起動を伴うため、検証本体は別スクリプトへ分ける。

scripts/verify-p0-docker
