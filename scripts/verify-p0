#!/usr/bin/env bash
# P0 Project Foundation の累積検証。
#
# P0 のタスクが進むたびに検証を追加していく。
# 各検証は、対応するタスクが開始された時点で自動的に有効になる。
# これにより、実装していないタスクを Code Pact の構造検査だけで完了できない状態を保つ。
#
# P0-T6 以降、このスクリプトは bin/verify --full から呼ばれる内部実装とする。
# 利用者と CI が直接実行する入口にはしない。
set -euo pipefail

# 進捗イベントの有無でタスクの開始を判定する。
# started / done のいずれかが記録されていれば、そのタスクの検証を有効にする。
task_has_event() {
  local task_id="$1"
  grep -Rqs "^task_id: ${task_id}$" .code-pact/state/events
}

# 必須の行がちょうど 1 件だけ存在することを確認する。
# 欠落と重複の両方を失敗として扱う。
# 単純な存在確認では、既存設定を置換した不完全なファイルや、
# 同じ行を繰り返し追記したファイルを検出できない。
require_exact_line_once() {
  local expected="$1"
  local file="$2"
  local count

  if [[ ! -f "$file" ]]; then
    printf 'required file is missing: %s\n' "$file" >&2
    return 1
  fi

  count="$(
    awk -v expected="$expected" '
      $0 == expected { count += 1 }
      END { print count + 0 }
    ' "$file"
  )"

  if [[ "$count" -ne 1 ]]; then
    printf \
      'expected exactly one line in %s, found %s: %s\n' \
      "$file" \
      "$count" \
      "$expected" \
      >&2
    return 1
  fi
}

# --- 開発ランタイム -----------------------------------------------------------
#
# ファイルに書かれたバージョンだけでなく、実際に動いている Node.js を検査する。
# バージョンマネージャーの切り替え漏れを、Code Pact の検証より前に失敗させる。

test -f .node-version

expected_node_version="$(tr -d '\r\n' < .node-version)"

test "$expected_node_version" = "24.18.0"
test "$(node --version)" = "v${expected_node_version}"

node -e '
  const packageJson = require("./package.json");

  if (packageJson.engines?.node !== ">=24.18.0 <25") {
    console.error(
      `unexpected package.json engines.node: ${packageJson.engines?.node}`
    );
    process.exit(1);
  }
'

# --- P0-T2 / P0-T2A / P0-T2B / P0-T2C: Code Pact 制御面 ----------------------
#
# plan lint は必ず strict で実行する。
# --strict でのみ終了コードへ反映される警告（TASK_ID_PHASE_PREFIX など）を見逃さない。

npm run pact:validate >/dev/null
npm run pact:lint >/dev/null

test -f design/brief.md
test -f design/constitution.md
test -f design/rules/coding-style.md
test -f design/rules/code-pact-execution.md
test -f design/acceptance/P0-T3-rails-bootstrap.md
test -f docs/development/code-pact.md

# --- 既存 .gitignore 設定の保持 -----------------------------------------------
#
# P0-T3 で Rails 用の除外設定を追記する際、これらを置換・削除・重複させない。

project_gitignore_lines=(
  "/node_modules/"
  "/.code-pact/locks/"
  "/.code-pact/state/locks/"
  "/.code-pact/cache/"
  "/.local/"
  "/.context/"
)

for line in "${project_gitignore_lines[@]}"; do
  require_exact_line_once "$line" .gitignore
done

# --- P0 全体で持ち込まない生成物 ---------------------------------------------
#
# デプロイ基盤（Kamal）、Thruster、開発用コンテナは現在のロードマップで採用していない。
# Rails が一時生成する master key と、それで暗号化された credentials も持ち込まない。

test ! -e .kamal
test ! -e config/deploy.yml
test ! -e bin/kamal
test ! -e bin/thrust
test ! -e .devcontainer
test ! -e config/master.key
test ! -e config/credentials.yml.enc

# --- P0-T4 以前: Docker 関連ファイルの混入を拒否 -----------------------------

if ! task_has_event "P0-T4"; then
  test ! -e Dockerfile
  test ! -e compose.yaml
  test ! -e docker-compose.yml
  test ! -e .dockerignore
  test ! -e bin/docker-entrypoint
fi

# --- P0-T7 以前: GitHub Actions 関連ファイルの混入を拒否 ---------------------
#
# bin/ci はローカル検証の入口であり、GitHub Actions ではない。これは拒否しない。
# bin/verify との関係は P0-T6 の検証で確定する。

if ! task_has_event "P0-T7"; then
  test ! -e .github/workflows
  test ! -e .github/dependabot.yml
fi

# --- P0-T3: Rails アプリケーションの実体 -------------------------------------
#
# P0-T3 が開始された時点で有効になる。
# 受け入れ条件の詳細は design/acceptance/P0-T3-rails-bootstrap.md を参照する。

if task_has_event "P0-T3"; then
  test -f Gemfile
  test -f Gemfile.lock
  test -f Rakefile
  test -f config.ru
  test -x bin/rails
  test -f config/application.rb
  test -f config/database.yml
  test -d app
  test -d test

  # 固定バージョン。ファイルの内容だけでなく実行中のランタイムを検査する。
  test -f .ruby-version
  test "$(tr -d '\r\n' < .ruby-version)" = "4.0.6"
  test "$(ruby -e 'print RUBY_VERSION')" = "4.0.6"
  test "$(bundle exec rails --version)" = "Rails 8.1.3"

  # --skip-git で生成されない Git 管理ファイルを補っていること
  test -f .gitignore
  test -f .gitattributes
  test -f .rubocop.yml

  # Rails 8.1.3 標準の除外設定。
  # .keep の除外解除がないと、維持すると宣言した .keep が Git 管理対象にならない。
  rails_gitignore_lines=(
    "/.bundle"
    "/.env*"
    "/log/*"
    "!/log/.keep"
    "/tmp/*"
    "!/tmp/.keep"
    "/tmp/pids/*"
    "!/tmp/pids/"
    "!/tmp/pids/.keep"
    "/storage/*"
    "!/storage/.keep"
    "/tmp/storage/*"
    "!/tmp/storage/"
    "!/tmp/storage/.keep"
    "/public/assets"
    "/config/*.key"
  )

  for line in "${rails_gitignore_lines[@]}"; do
    require_exact_line_once "$line" .gitignore
  done

  require_exact_line_once "db/schema.rb linguist-generated" .gitattributes
  require_exact_line_once "vendor/* linguist-vendored" .gitattributes

  grep -Eq 'gem[[:space:]]+["'\'']pg["'\'']' Gemfile
  grep -Eq 'adapter:[[:space:]]*postgresql' config/database.yml
  grep -Eq 'module[[:space:]]+RoleWeave' config/application.rb

  bundle check

  # PostgreSQL サーバーがない状態で boot できることを確認する。
  # 接続不能な DATABASE_URL を与え、boot 中に不用意な DB 接続が起きていないことを検出する。
  env \
    RAILS_ENV=test \
    DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
    PGCONNECT_TIMEOUT=1 \
    bundle exec rails zeitwerk:check

  env \
    RAILS_ENV=test \
    DATABASE_URL=postgresql://127.0.0.1:1/roleweave_test \
    PGCONNECT_TIMEOUT=1 \
    bundle exec rails runner \
    'abort "unexpected application namespace" unless Rails.application.class.module_parent_name == "RoleWeave"'

  # Rails 生成後、README が事実誤認を残していないこと
  ! grep -Fq 'アプリケーションは実装されていません' README.md
  ! grep -Fq 'application itself has not been implemented' README.en.md
fi

# --- P0-T6: 統一検証コマンド --------------------------------------------------
#
# P0-T6 が開始された時点で有効になる。
# Docker 検証は build とコンテナ起動を伴うため、契約違反はその前に失敗させる。
# 受け入れ条件の詳細は design/acceptance/P0-T6-unified-verification.md を参照する。

if task_has_event "P0-T6"; then
  test -x bin/verify
  test -x bin/ci

  # 検証定義の二重正本を残さない。
  test ! -e config/ci.rb

  bash -n bin/verify
  bash -n bin/ci

  # フェーズ検証コマンドは YAML として解析する。
  # Code Pact の serializer は表記を正規化するため、インデント前提の grep では検出できない。
  ruby -ryaml -e '
    phase = YAML.load_file("design/phases/P0-project-foundation.yaml")
    commands = phase.fetch("verification").fetch("commands")

    abort "unexpected P0 verification command: #{commands.inspect}" \
      unless commands == ["bin/verify --full"]
  '

  # コメント行は検査対象から外す。
  # 正規コマンドを説明するヘッダーコメントと、実際に実行するコマンドを混同しない。
  verify_body="$(grep -v '^[[:space:]]*#' bin/verify)"

  required_verify_commands=(
    'bundle check'
    'npm ls --depth=0'
    'npm run pact:validate'
    'npm run pact:lint'
    'bin/rubocop'
    'env RAILS_ENV=test bin/rails db:prepare'
    'env RAILS_ENV=test bin/rails zeitwerk:check'
    'env RAILS_ENV=test bin/rails test'
  )

  for command in "${required_verify_commands[@]}"; do
    if ! printf '%s\n' "$verify_body" | grep -Fq "$command"; then
      printf 'bin/verify is missing required command: %s\n' "$command" >&2
      exit 1
    fi
  done

  # 標準モードは Docker を起動しない。基盤検証は完全モードの責務とする。
  if printf '%s\n' "$verify_body" | grep -Eq '(^|[[:space:]])docker([[:space:]]|$)'; then
    printf 'bin/verify standard mode must not invoke Docker directly\n' >&2
    exit 1
  fi

  # セットアップと検証を混在させない。
  if printf '%s\n' "$verify_body" | grep -Fq 'bin/setup'; then
    printf 'bin/verify must not perform setup\n' >&2
    exit 1
  fi

  # セキュリティ・依存関係検査の必須化は P0-T9 で扱う。
  if printf '%s\n' "$verify_body" | grep -Eq 'bundler-audit|importmap audit|brakeman'; then
    printf 'security audits belong to P0-T9\n' >&2
    exit 1
  fi

  # bin/ci は委譲するだけの互換ラッパーとする。
  grep -Fq 'exec "$APP_ROOT/bin/verify" --full "$@"' bin/ci

  # 完全モードをコンテナ内から呼ぶと、この検証自身を無限に呼び戻す。
  docker_verification_body="$(grep -v '^[[:space:]]*#' scripts/verify-p0-docker)"

  if printf '%s\n' "$docker_verification_body" | grep -Fq 'bin/verify --full'; then
    printf 'scripts/verify-p0-docker must not invoke the full mode\n' >&2
    exit 1
  fi
fi

# --- P0-T4: Docker Compose と PostgreSQL -------------------------------------
#
# P0-T4 が開始された時点で有効になる。
# Docker daemon への接続とコンテナの起動を伴うため、検証本体は別スクリプトへ分ける。
# 受け入れ条件の詳細は design/acceptance/P0-T4-docker-compose.md を参照する。

if task_has_event "P0-T4"; then
  scripts/verify-p0-docker
fi
