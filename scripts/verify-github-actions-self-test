#!/usr/bin/env ruby
# scripts/verify-github-actions の回帰検査。
#
# scripts/verify-p0 から呼び出される。
#
# 構造検査は「契約違反を拒否できること」まで含めて初めて意味を持つ。
# 負の検証を実行時の手作業に依存させると、検証器が退行しても気づけない。
# ここでは正規の Workflow へ変異を加え、すべてが拒否されることを毎回確認する。
#
# 変異は検証器が検査する項目とだけ対応させる。
# 検査していない表記へ変異を足すと、検証器を縛るのではなく
# 「いま拒否されている」という観測を固定するだけになる。
#
# 変異は一時ディレクトリへ複製した Workflow に対してのみ行う。
# .github/workflows/ci.yml は読み取るだけで、書き換えない。

require "tmpdir"

WORKFLOW_PATH = ".github/workflows/ci.yml"
VERIFIER_PATH = "scripts/verify-github-actions"

# Action 固定の変異は登録済みのすべてに対して行う。
# 実装が現時点で汎用であることではなく、
# 将来一部の Action だけ検査対象から漏れた場合に検出することが目的である。
ACTION_PINS = {
  "actions/checkout" => { sha: "3d3c42e5aac5ba805825da76410c181273ba90b1", tag: "v7.0.1" },
  "ruby/setup-ruby" => { sha: "95ef2b042f9d7a56d8268cba8559e2842e2ad01b", tag: "v1.321.0" }
}.freeze

ACTION_MUTATIONS = ACTION_PINS.flat_map do |action, pin|
  [
    [ "#{action} のSHA改ざん", ->(text) { text.sub("#{action}@#{pin.fetch(:sha)}", "#{action}@#{'0' * 40}") } ],
    [
      "#{action} のタグ改ざん",
      lambda do |text|
        text.sub("#{action}@#{pin.fetch(:sha)} # #{pin.fetch(:tag)}", "#{action}@#{pin.fetch(:sha)} # v999.0.0")
      end
    ],
    [
      "#{action} の可変タグ参照",
      ->(text) { text.sub("#{action}@#{pin.fetch(:sha)}", "#{action}@#{pin.fetch(:tag)}") }
    ],
    [
      "#{action} のタグコメント削除",
      ->(text) { text.sub("#{action}@#{pin.fetch(:sha)} # #{pin.fetch(:tag)}", "#{action}@#{pin.fetch(:sha)}") }
    ]
  ]
end.to_h.freeze

# 変異は正規の Workflow に対する文字列置換で表現する。
# 置換が適用されなかった場合は、Workflow 側の変更に追随できていないため失敗させる。
MUTATIONS = ACTION_MUTATIONS.merge({
  # --- 供給元 -----------------------------------------------------------------
  "引用符付きusesキー" => ->(text) { text.sub("uses: actions/checkout@", "\"uses\": actions/checkout@") },
  "未承認のActionの追加" => ->(text) {
    text.sub(
      "      - name: リポジトリを取得\n",
      "      - name: Node.jsを準備\n" \
      "        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0\n\n" \
      "      - name: リポジトリを取得\n"
    )
  },

  # --- Trigger ----------------------------------------------------------------
  "onキーをtrueへ変更" => ->(text) { text.sub(/^on:$/, "true:") },
  "onキーをyesへ変更" => ->(text) { text.sub(/^on:$/, "yes:") },
  "pull_request_target" => ->(text) { text.sub("  pull_request:", "  pull_request_target:") },
  "pushの対象ブランチ拡大" => ->(text) { text.sub("      - main\n", "      - main\n      - release\n") },

  # --- 権限とシークレット -----------------------------------------------------
  "write権限" => ->(text) { text.sub("  contents: read", "  contents: write") },
  "認証情報の保持" => ->(text) {
    text.sub("          persist-credentials: false", "          persist-credentials: true")
  },
  "persist-credentialsの削除" => ->(text) { text.sub("          persist-credentials: false\n", "") },
  "version fileの重複記述" => ->(text) {
    text.sub("          ruby-version: .ruby-version", "          ruby-version: 4.0.6")
  },
  "secretsのドット参照" => ->(text) {
    text.sub("    steps:", "    env:\n      TOKEN: ${{ secrets.TOKEN }}\n\n    steps:")
  },
  "secretsコンテキスト全体の参照" => ->(text) {
    text.sub("    steps:", "    env:\n      DUMP: ${{ toJSON(secrets) }}\n\n    steps:")
  },
  "secretsの添字参照" => ->(text) {
    text.sub("    steps:", "    env:\n      TOKEN: ${{ secrets['TOKEN'] }}\n\n    steps:")
  },
  "github.tokenの参照" => ->(text) {
    text.sub("    steps:", "    env:\n      TOKEN: ${{ github.token }}\n\n    steps:")
  },
  'github["token"]の参照' => ->(text) {
    text.sub("    steps:", "    env:\n      TOKEN: ${{ github[\"token\"] }}\n\n    steps:")
  },

  # --- 実行環境 ---------------------------------------------------------------
  "ubuntu-latest" => ->(text) { text.sub("    runs-on: ubuntu-24.04", "    runs-on: ubuntu-latest") },
  "timeoutの削除" => ->(text) { text.sub(/^    timeout-minutes: \d+\n/, "") },
  "timeoutを浮動小数へ変更" => ->(text) { text.sub(/^(    timeout-minutes: \d+)$/, '\1.0') },
  "timeoutを文字列へ変更" => ->(text) { text.sub(/^    timeout-minutes: (\d+)$/, '    timeout-minutes: "\1"') },
  "job権限の上書き" => ->(text) {
    text.sub("    steps:", "    permissions:\n      contents: write\n\n    steps:")
  },
  "continue-on-error" => ->(text) { text.sub("    steps:", "    continue-on-error: true\n\n    steps:") },
  "containerの指定" => ->(text) {
    text.sub("    steps:", "    container: ruby:4.0.6-slim-bookworm\n\n    steps:")
  },

  # --- 同時実行 ---------------------------------------------------------------
  "concurrency groupの固定値化" => ->(text) {
    text.sub("group: ci-${{ github.workflow }}-${{ github.ref }}", "group: global")
  },
  "concurrencyの削除" => ->(text) {
    text.sub(
      "concurrency:\n  group: ci-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\n",
      ""
    )
  },

  # --- 重複した mapping key ---------------------------------------------------
  #
  # Psych は後勝ちで畳み込むため、前方の定義は解析結果から消える。
  "pushの重複" => ->(text) {
    text.sub(
      "  push:\n    branches:\n      - main\n",
      "  push:\n    branches:\n      - feature\n  push:\n    branches:\n      - main\n"
    )
  },
  "contentsの重複" => ->(text) { text.sub("  contents: read", "  contents: write\n  contents: read") },
  "引用符違いのキー重複" => ->(text) { text.sub("  contents: read", "  \"contents\": write\n  contents: read") },

  # --- 複数 document ----------------------------------------------------------
  #
  # YAML.safe_load は最初の document だけを返す。
  "空の2件目document" => ->(text) { "#{text}---\n" },
  "secretsを含む2件目document" => ->(text) { "#{text}---\n\"x\": \"${{ secrets.TOKEN }}\"\n" },
  "document終端後の裸のscalar" => ->(text) { "#{text}...\n\nplain-trailing-content\n" }
}).freeze

# 検証器の終了コードだけを見る。出力は失敗時の説明に使う。
def verify(path)
  output = IO.popen([ VERIFIER_PATH, path ], err: [ :child, :out ], &:read)
  [ $?.success?, output ]
end

unless ARGV.empty?
  warn "使用方法: scripts/verify-github-actions-self-test"
  exit 1
end

unless File.file?(WORKFLOW_PATH)
  warn "workflow is missing: #{WORKFLOW_PATH}"
  exit 1
end

original = File.read(WORKFLOW_PATH, encoding: "UTF-8")
failures = []

Dir.mktmpdir("verify-github-actions-self-test") do |directory|
  path = File.join(directory, "ci.yml")

  # 陽性対照。正規の Workflow が通過しない検証器は、負の検証も信用できない。
  File.write(path, original, encoding: "UTF-8")
  passed, output = verify(path)

  unless passed
    failures << "the canonical workflow must pass the structural check:\n#{output}"
  end

  MUTATIONS.each do |label, mutate|
    mutated = mutate.call(original)

    if mutated == original
      failures << "mutation #{label.inspect} did not change the workflow. update the self test"
      next
    end

    File.write(path, mutated, encoding: "UTF-8")
    passed, = verify(path)

    failures << "mutation #{label.inspect} must be rejected by #{VERIFIER_PATH}" if passed
  end
end

unless failures.empty?
  failures.each { |failure| warn("self test failure: #{failure}") }
  exit 1
end
